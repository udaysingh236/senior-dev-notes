---
// The landing page's living diagram: three clients, a load balancer, two app servers, a cache and a
// database, with requests flowing down and answers flowing back. Blue dots are requests on their
// way; green dots are answers; the amber one is a slow query. The site's diagram colours mean the
// same thing here as on every topic page.
//
// Motion is SMIL <animateMotion>, so it costs no JavaScript per frame. The script pauses it when the
// hero is off screen, and freezes it on a still frame when the reader prefers reduced motion.

interface Trip {
  path: string;
  dur: number; // seconds for the full round trip
  begin: number; // seconds
  answer: 'ok' | 'warn';
}

// Anchor points, in viewBox units.
const C = [80, 220, 360]; // client centres
const LB = { x: 220, top: 150, bottom: 204 };
const APP = [115, 325];
const APP_TOP = 270;
const APP_BOTTOM = 324;
const STORE_TOP = 388; // cache under app 1, database under app 2

const route = (client: number, app: number, store: number) =>
  `M${C[client]} 74 L${LB.x} ${LB.top} L${LB.x} ${LB.bottom} L${APP[app]} ${APP_TOP} L${APP[app]} ${APP_BOTTOM} L${APP[store]} ${STORE_TOP}`;

const trips: Trip[] = [
  { path: route(0, 0, 0), dur: 3.4, begin: 0, answer: 'ok' },
  { path: route(1, 1, 1), dur: 4.4, begin: 0.9, answer: 'ok' },
  { path: route(2, 1, 0), dur: 3.8, begin: 1.7, answer: 'ok' },
  { path: route(1, 0, 1), dur: 4.2, begin: 2.6, answer: 'ok' },
  { path: route(0, 1, 0), dur: 3.6, begin: 3.3, answer: 'ok' },
  { path: route(2, 0, 1), dur: 6.2, begin: 4.1, answer: 'warn' },
];

const box = 'stroke-width: 2';
---

<figure class="hero-system" data-hero-system>
  <svg viewBox="0 0 440 486" width="100%" role="img" aria-labelledby="hs-t hs-d">
    <title id="hs-t">A small production system, live</title>
    <desc id="hs-d">
      Three clients, a phone, a laptop and a script, send requests to a load balancer, which spreads
      them across two app servers. The app servers read from a cache, which answers in about 2 ms,
      and a database, which answers in about 40 ms. Requests travel down as blue dots and answers
      travel back up as green dots; one slow query comes back amber.
    </desc>

    <defs>
      {trips.map((t, i) => <path id={`hs-route-${i}`} d={t.path} fill="none" />)}
    </defs>

    <!-- Wiring -->
    <g class="hs-wire" fill="none">
      {C.map((x) => <path d={`M${x} 74 L${LB.x} ${LB.top}`} />)}
      {APP.map((x) => <path d={`M${LB.x} ${LB.bottom} L${x} ${APP_TOP}`} />)}
      {APP.map((x) => APP.map((s) => <path d={`M${x} ${APP_BOTTOM} L${s} ${STORE_TOP}`} />))}
    </g>

    <!-- Traffic: each dot goes down its route and comes back up, changing colour at the bottom. -->
    <g class="hs-traffic">
      {
        // Two dots per trip share one motion: the request (blue) shows on the way down, the answer
        // (green or amber) on the way back. SMIL cannot animate to a CSS variable, so the colour
        // swap is an opacity swap between two dots styled by class. Begin times are negative so
        // every trip is already under way when the page loads, instead of parked at (0, 0).
        trips.map((t, i) =>
          (['flow', t.answer] as const).map((tone, half) => (
            <circle r="7" class={`hs-dot hs-dot-${tone}`} opacity={half}>
              <animateMotion
                dur={`${t.dur}s`}
                begin={`-${t.begin}s`}
                repeatCount="indefinite"
                keyPoints="0;1;1;0"
                keyTimes="0;0.44;0.56;1"
                calcMode="linear"
              >
                <mpath href={`#hs-route-${i}`} />
              </animateMotion>
              <animate
                attributeName="opacity"
                dur={`${t.dur}s`}
                begin={`-${t.begin}s`}
                repeatCount="indefinite"
                calcMode="discrete"
                keyTimes="0;0.5"
                values={half ? '0;1' : '1;0'}
              />
            </circle>
          )),
        )
      }
    </g>

    <!-- Boxes, drawn over the wiring so dots disappear into them and come out again. -->
    <g font-size="20" text-anchor="middle" class="hs-boxes">
      {
        ['phone', 'laptop', 'script'].map((label, i) => (
          <g>
            <rect x={C[i] - 60} y="20" width="120" height="54" rx="15" style={`fill: var(--viz-client-soft); stroke: var(--viz-client); ${box}`} />
            <text x={C[i]} y="54" font-weight="600" style="fill: var(--viz-ink)">{label}</text>
          </g>
        ))
      }

      <rect x="110" y={LB.top} width="220" height="54" rx="7" style={`fill: var(--viz-server-soft); stroke: var(--viz-server); ${box}`} />
      <text x="220" y="184" font-weight="600" style="fill: var(--viz-ink)">load balancer</text>
      <circle cx="312" cy="166" r="5" class="hs-led" />

      {
        APP.map((x, i) => (
          <g>
            <rect x={x - 75} y={APP_TOP} width="150" height="54" rx="7" style={`fill: var(--viz-server-soft); stroke: var(--viz-server); ${box}`} />
            <text x={x} y="304" font-weight="600" style="fill: var(--viz-ink)">{`app ${i + 1}`}</text>
            <circle cx={x + 57} cy="286" r="5" class="hs-led" style={`animation-delay: ${0.7 + i * 0.9}s`} />
          </g>
        ))
      }

      {
        [
          { x: APP[0], label: 'cache', note: 'hit · 2 ms' },
          { x: APP[1], label: 'database', note: 'query · 40 ms' },
        ].map(({ x, label, note }) => (
          <g>
            <path
              d={`M${x - 70} ${STORE_TOP + 8} a70 11 0 0 1 140 0 v40 a70 11 0 0 1 -140 0 z`}
              style={`fill: var(--viz-store-soft); stroke: var(--viz-store); ${box}`}
            />
            <path d={`M${x - 70} ${STORE_TOP + 8} a70 11 0 0 0 140 0`} fill="none" style={`stroke: var(--viz-store); ${box}`} />
            <text x={x} y={STORE_TOP + 42} font-weight="600" style="fill: var(--viz-ink)">{label}</text>
            <text x={x} y={STORE_TOP + 92} class="hs-note">{note}</text>
          </g>
        ))
      }
    </g>
  </svg>
</figure>

<style>
  .hero-system {
    margin: 0;
  }
  .hero-system svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hs-wire path {
    stroke: var(--viz-stroke);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hs-wire path {
      animation: hs-march 1.6s linear infinite;
    }
  }
  @keyframes hs-march {
    to {
      stroke-dashoffset: -20;
    }
  }
  .hs-dot-flow {
    fill: var(--viz-flow);
  }
  .hs-dot-ok {
    fill: var(--viz-ok);
  }
  .hs-dot-warn {
    fill: var(--viz-warn);
  }
  .hs-led {
    fill: var(--viz-ok);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hs-led {
      animation: hs-blink 2.4s ease-in-out infinite;
    }
  }
  @keyframes hs-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  .hs-note {
    font-family: var(--note-font-display);
    font-style: italic;
    font-size: 21px;
    fill: var(--viz-muted);
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-hero-system]')) {
    const svg = fig.querySelector('svg')!;
    let onScreen = true;

    const apply = () => {
      if (reduce.matches) {
        // A still frame with dots spread along their routes, so the picture still tells the story.
        svg.pauseAnimations();
        svg.setCurrentTime(5.2);
      } else if (onScreen) {
        svg.unpauseAnimations();
      } else {
        svg.pauseAnimations();
      }
    };

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      apply();
    }).observe(fig);
    reduce.addEventListener('change', apply);
    apply();
  }
</script>
