---
// A diagram with a caption. On small screens, tapping the figure opens it full screen at a
// larger size so labels stay readable and the reader can pan around. The enlarge button works
// at every width. Set enlarge={false} for interactive content that needs taps of its own.
interface Props {
  /** One sentence that repeats the key point of the figure in words. */
  caption?: string;
  enlarge?: boolean;
  /**
   * Let the diagram use the full column width. By default it is capped at about 34rem, which
   * suits the usual 400-unit-wide viewBox; set wide for diagrams drawn 640 units or wider.
   */
  wide?: boolean;
}

const { caption, enlarge = true, wide = false } = Astro.props;
const hasCaptionSlot = Astro.slots.has('caption');
---

<figure class:list={['viz-figure not-content', { 'viz-figure-wide': wide }]} data-figure={enlarge ? '' : undefined}>
  <div class="viz-figure-body" data-figure-body>
    <slot />
  </div>
  {
    enlarge && (
      <button class="viz-figure-enlarge" type="button" data-figure-open>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="sr-only">Enlarge figure</span>
      </button>
    )
  }
  {
    (caption || hasCaptionSlot) && (
      <figcaption>
        {caption}
        <slot name="caption" />
      </figcaption>
    )
  }
</figure>

<style is:global>
  /* Global because the dialog is created by the script below, outside this component. */
  .viz-figure {
    position: relative;
    margin: 2rem 0;
  }
  .viz-figure-body {
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.85rem;
    /* A faint blueprint grid behind every diagram. */
    background:
      linear-gradient(var(--note-grid) 1px, transparent 1px) 0 0 / 20px 20px,
      linear-gradient(90deg, var(--note-grid) 1px, transparent 1px) 0 0 / 20px 20px,
      var(--viz-surface);
    box-shadow: var(--note-shadow);
    color: var(--viz-ink);
  }
  .viz-figure-body > svg,
  .viz-figure-body svg[role='img'] {
    display: block;
    width: 100%;
    max-width: 34rem;
    height: auto;
    margin: 0 auto;
  }
  .viz-figure-wide .viz-figure-body > svg,
  .viz-figure-wide .viz-figure-body svg[role='img'],
  .viz-figure-dialog-content svg {
    max-width: none;
  }
  @media (max-width: 50rem) {
    [data-figure] .viz-figure-body {
      cursor: zoom-in;
    }
  }
  .viz-figure-enlarge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.5rem;
    background: var(--note-paper-raised);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, transform 0.25s var(--note-ease);
  }
  .viz-figure-enlarge:hover {
    transform: scale(1.06);
  }
  .viz-figure-enlarge:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
  .viz-figure figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  /* Figures are numbered down the page, like a notebook: "Fig. 3". */
  .sl-markdown-content .viz-figure figcaption::before {
    counter-increment: note-figure;
    content: 'Fig. ' counter(note-figure);
    margin-inline-end: 0.6rem;
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--note-margin);
  }

  .viz-figure-dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--viz-surface);
    color: var(--viz-ink);
  }
  .viz-figure-dialog::backdrop {
    background: var(--sl-color-backdrop-overlay);
  }
  .viz-figure-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .viz-figure-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .viz-figure-dialog-close {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }
  .viz-figure-dialog-scroll {
    flex: 1;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem;
  }
  /* About twice the phone width, so labels are large and the reader pans around. */
  .viz-figure-dialog-content {
    width: max(100%, 44rem);
    max-width: 80rem;
    margin: 0 auto;
  }
  .viz-figure-dialog-content svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .viz-figure-dialog-caption {
    margin-top: 0.75rem;
    max-width: 45rem;
    color: var(--sl-color-gray-2);
  }
  @media (min-width: 50rem) {
    .viz-figure-dialog-hint {
      visibility: hidden;
    }
  }
</style>

<script>
  const SMALL_SCREEN = window.matchMedia('(max-width: 50rem)');
  let dialog: HTMLDialogElement | undefined;

  function getDialog(): HTMLDialogElement {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'viz-figure-dialog';
    dialog.setAttribute('aria-label', 'Enlarged figure');
    dialog.innerHTML = `
      <div class="viz-figure-dialog-bar">
        <span class="viz-figure-dialog-hint">Scroll or drag to pan</span>
        <button type="button" class="viz-figure-dialog-close">Close</button>
      </div>
      <div class="viz-figure-dialog-scroll"><div class="viz-figure-dialog-content"></div></div>`;
    document.body.append(dialog);
    dialog.querySelector('.viz-figure-dialog-close')!.addEventListener('click', () => dialog!.close());
    // Clicking the backdrop (outside the content) closes too.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog!.close();
    });
    return dialog;
  }

  function open(figure: HTMLElement) {
    const body = figure.querySelector<HTMLElement>('[data-figure-body]')!;
    const d = getDialog();
    const content = d.querySelector<HTMLElement>('.viz-figure-dialog-content')!;
    const caption = figure.querySelector('figcaption');
    // Move the real nodes rather than cloning them, so SVG ids stay unique on the page.
    content.replaceChildren(...body.childNodes);
    if (caption) {
      const cap = document.createElement('p');
      cap.className = 'viz-figure-dialog-caption';
      cap.textContent = caption.textContent;
      content.append(cap);
    }
    d.addEventListener(
      'close',
      () => {
        content.querySelector('.viz-figure-dialog-caption')?.remove();
        body.replaceChildren(...content.childNodes);
        figure.querySelector<HTMLElement>('[data-figure-open]')?.focus();
      },
      { once: true },
    );
    d.showModal();
  }

  for (const figure of document.querySelectorAll<HTMLElement>('[data-figure]')) {
    figure.querySelector('[data-figure-open]')?.addEventListener('click', () => open(figure));
    figure.querySelector('[data-figure-body]')?.addEventListener('click', () => {
      if (SMALL_SCREEN.matches) open(figure);
    });
  }
</script>
