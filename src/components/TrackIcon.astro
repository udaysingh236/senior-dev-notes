---
// A small line icon for each track, drawn on a 24-unit grid in the current text colour.
// Used on the landing page, the roadmap and topic headers.
interface Props {
  /** Track folder name from CURRICULUM.md. */
  track: string;
  size?: number;
  class?: string;
}

const { track, size = 24, class: className } = Astro.props;

const PATHS: Record<string, string> = {
  // Stacked layers
  foundations: 'M12 3 3 8l9 5 9-5-9-5Z M3 12.5l9 5 9-5 M3 17l9 5 9-5',
  // A globe with a meridian
  networking: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3 12h18 M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9 M12 3c-2.6 2.6-3.8 5.6-3.8 9s1.2 6.4 3.8 9',
  // One road splitting into three
  traffic: 'M12 21v-7 M12 14 5 7 M12 14l7-7 M12 14V4 M3 9l2-2 2 2 M17 9l2-2 2 2 M10 6l2-2 2 2',
  // A database cylinder
  databases: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Z M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6 M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  // A lightning bolt
  caching: 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z',
  // Three nodes in a ring
  'distributed-systems': 'M12 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z M5 15.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z M19 15.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z M10.8 8.3 6.2 15.7 M13.2 8.3l4.6 7.4 M7.5 18h9',
  // Messages in a queue
  messaging: 'M3 7h4v10H3z M10 7h4v10h-4z M17 7h4v10h-4z M1 12h1 M22 12h1',
  // A shield with a tick
  resilience: 'M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6l-8-3Z M8.5 12l2.5 2.5 4.5-5',
  // A padlock
  security: 'M6 11h12v10H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3 M12 15v2',
  // A gauge
  performance: 'M4.5 18a8.5 8.5 0 1 1 15 0 M12 14l4-5 M12 14a1.3 1.3 0 1 0 0 .1',
  // A box being shipped
  delivery: 'M3 8 12 3l9 5v8l-9 5-9-5V8Z M3 8l9 5 9-5 M12 13v8',
  // A line chart with a magnifier feel
  observability: 'M3 20h18 M4 16l4-5 4 3 5-7 3 3',
  // A spark
  'ai-systems': 'M12 3c.6 4.3 2.7 6.4 7 7-4.3.6-6.4 2.7-7 7-.6-4.3-2.7-6.4-7-7 4.3-.6 6.4-2.7 7-7Z M19 16c.3 1.6 1 2.3 2.5 2.5-1.5.3-2.2 1-2.5 2.5-.3-1.5-1-2.2-2.5-2.5 1.5-.2 2.2-.9 2.5-2.5Z',
  // A blueprint sheet with a drawn box
  'case-studies': 'M4 3h16v18H4z M8 8h8v6H8z M8 17h5',
};

const d = PATHS[track] ?? PATHS.foundations;
---

<svg
  class:list={['track-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
