---
// Starlight's footer (edit link, last updated, pagination) followed by the site's colophon.
// Also carries the two small scripts every page shares: scroll reveal and the reading progress bar.
import Default from '@astrojs/starlight/components/Footer.astro';
import logo from '../assets/logo.svg';

const REPO = 'https://github.com/udaysingh236/senior-dev-notes';
---

<Default />

<div class="colophon not-content">
  <div class="colophon-brand">
    <img src={logo.src} width="36" height="36" alt="" />
    <div>
      <p class="colophon-name">Senior Dev Notes</p>
      <p class="colophon-line">System design, explained like a mentor would.</p>
    </div>
  </div>
  <nav class="colophon-links" aria-label="Site">
    <a href="/roadmap/">Roadmap</a>
    <a href="/about/">About</a>
    <a href="/about/#suggest-a-topic">Suggest a topic</a>
    <a href={REPO}>Source on GitHub</a>
  </nav>
  <p class="colophon-fine">
    Written by Uday. Every page is researched, reviewed by a human, and every code example was run before it was
    published.
  </p>
</div>

<style>
  .colophon {
    display: grid;
    gap: 1.1rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px dashed var(--sl-color-gray-5);
  }
  .colophon-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .colophon-brand p {
    margin: 0;
  }
  .colophon-name {
    font-family: var(--note-font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .colophon-line {
    font-family: var(--note-font-display);
    font-style: italic;
    color: var(--sl-color-gray-3);
  }
  .colophon-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }
  .colophon-links a {
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    background: linear-gradient(var(--note-margin), var(--note-margin)) no-repeat 0 100% / 0 1.5px;
    transition: background-size 0.3s var(--note-ease), color 0.2s;
  }
  .colophon-links a:hover {
    color: var(--sl-color-white);
    background-size: 100% 1.5px;
  }
  .colophon-fine {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>

<script>
  // Scroll reveal. Only elements that start below the fold are hidden and revealed, so nothing
  // already on screen flickers, and without JavaScript everything stays visible.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    // Topic pages: reveal the visuals and asides as the reader reaches them.
    document
      .querySelectorAll('.sl-markdown-content :is(.viz-figure, .sim, .st, .starlight-aside, .expressive-code, .next-topics > li)')
      .forEach((el) => el.setAttribute('data-reveal', ''));

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    for (const el of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
      if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
      else io.observe(el);
    }
    document.documentElement.classList.add('js-reveal');
  }

  // Reading progress: a thin ink line under the header on topic pages.
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('.sl-markdown-content');
  if (bar && article) {
    let queued = false;
    const update = () => {
      queued = false;
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const done = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${done})`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
