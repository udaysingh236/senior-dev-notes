---
// Outlier ejection, max ejection share and panic mode. See eject-model.ts.
import SimShell from '../../sim/SimShell.astro';
---

<SimShell
  name="lb-eject"
  title="Outlier ejection: a bad deploy on three of ten hosts"
  description="Ten hosts, each serving 100 requests a second, behind a balancer that picks the less busy of two random hosts. Each box shows a host's requests in flight, 'err' while it is failing, and 'out' while it is ejected. A request that takes longer than 250 ms times out. After five failures in a row a host is ejected for 10 seconds, longer each time. The chart shows the share of requests that succeed over the last 30 seconds. The button makes hosts 1 to 3 fail every request instantly for 20 seconds."
  watchFor="At the defaults (80% load, no cap on ejection, no panic mode) press the button. Hosts 1–3 are ejected within milliseconds, which looks right, but the seven left must carry 800 req/s with 700 of capacity. Their queues pass the timeout, they fail five in a row, and they are ejected too, until nothing is left. The bad deploy ends after 20 s; the outage does not, because each host that returns gets the entire load alone and is ejected again. Reset and try 'Max ejected' 10% (Envoy's default): success drops to about two thirds while the deploy lasts, then recovers at once. Or 'Panic below' 50%: the balancer stops trusting ejection once half the pool is gone, and about half the requests keep succeeding instead of none. At 60% load the seven hosts cope and plain ejection works."
  viewBox="0 0 400 240"
/>

<script>
  import { mountAll } from '../../sim/shell';
  import { createEjectModel } from './eject-model';

  mountAll('lb-eject', createEjectModel);
</script>
