---
// Hero: mean latency of one server with random arrivals, in multiples of the service time, against
// utilisation. The service-time band stays flat; the waiting on top of it grows as u / (1 − u).
const X0 = 46;
const W = 346;
const Y0 = 300; // y of latency = 0
const H = 250; // y-range for 0..21 × S
const ymax = 21;
const x = (u: number) => X0 + u * W;
const y = (m: number) => Y0 - (Math.min(m, ymax) / ymax) * H;
let curve = '';
for (let u = 0; u <= 0.953; u += 0.005) curve += `${curve ? 'L' : 'M'}${x(u).toFixed(1)} ${y(1 / (1 - u)).toFixed(1)}`;
const marks = [
  { u: 0.5, m: 2 },
  { u: 0.8, m: 5 },
  { u: 0.9, m: 10 },
  { u: 0.95, m: 20 },
];
---

<svg viewBox="0 0 400 344" width="100%" role="img" aria-labelledby="lvt-hs-t lvt-hs-d">
  <title id="lvt-hs-t">Latency against utilisation for one server with random arrivals</title>
  <desc id="lvt-hs-d">
    A chart with utilisation from 0 to 100% across and mean latency, in multiples of the time one
    request needs, up the side. A flat band at 1 times is the work itself. The curve on top is work
    plus waiting: 2 times at 50% utilisation, 5 times at 80%, 10 times at 90% and 20 times at 95%,
    rising without limit towards 100%.
  </desc>

  <rect x={X0} y={y(1)} width={W} height={Y0 - y(1)} style="fill: var(--viz-ok-soft)" />
  <path d={`${curve} L${x(0.953)} ${y(1)} L${x(0)} ${y(1)} Z`} style="fill: var(--viz-warn-soft)" />
  <path d={curve} fill="none" stroke-width="2.5" style="stroke: var(--viz-warn)" />
  <line x1={X0} y1={Y0} x2={X0 + W} y2={Y0} stroke-width="1.5" style="stroke: var(--viz-stroke)" />
  <line x1={X0} y1={Y0} x2={X0} y2={y(ymax)} stroke-width="1.5" style="stroke: var(--viz-stroke)" />

  <g font-size="14" style="fill: var(--viz-muted)">
    <text x={X0 - 6} y={y(1) + 5} text-anchor="end">1×</text>
    <text x={X0 - 6} y={y(10) + 5} text-anchor="end">10×</text>
    <text x={X0 - 6} y={y(20) + 5} text-anchor="end">20×</text>
    <text x={x(0)} y={Y0 + 18} text-anchor="middle">0</text>
    <text x={x(0.5)} y={Y0 + 18} text-anchor="middle">50%</text>
    <text x={x(1)} y={Y0 + 18} text-anchor="end">100%</text>
    <text x={x(1)} y={Y0 + 36} text-anchor="end">utilisation</text>
    <text x="4" y="22">latency</text>
  </g>

  {
    marks.map((mk) => (
      <g>
        <circle cx={x(mk.u)} cy={y(mk.m)} r="4.5" style="fill: var(--viz-ink)" />
        <text x={x(mk.u) - 8} y={y(mk.m) - 4} font-size="15" font-weight="700" text-anchor="end" style="fill: var(--viz-ink)">{mk.m}× at {Math.round(mk.u * 100)}%</text>
      </g>
    ))
  }
  <g font-size="15" style="fill: var(--viz-ink)">
    <rect x="64" y="44" width="14" height="14" rx="3" stroke-width="1.5" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
    <text x="84" y="56">waiting in the queue</text>
    <rect x="64" y="66" width="14" height="14" rx="3" stroke-width="1.5" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" />
    <text x="84" y="78">the work itself</text>
  </g>
</svg>
