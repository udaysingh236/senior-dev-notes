---
// Part 1 mental model: requests arrive, wait in a line, get served one at a time. Latency is
// the wait plus the work; throughput is how many finish per second; utilisation is how busy
// the server is.
const box = (x: number, y: number, w: number, h: number) => ({ x, y, width: w, height: h });
const waiting = [0, 1, 2, 3];
---

<svg viewBox="0 0 400 380" width="100%" role="img" aria-labelledby="lt-mm-t lt-mm-d">
  <title id="lt-mm-t">One server, one line: where latency, throughput and utilisation come from</title>
  <desc id="lt-mm-d">
    Requests arrive on the left at 180 a second, at random moments. They join a line of four
    waiting requests in front of one server that needs 5 ms per request and can finish at most 200
    a second. Finished requests leave on the right at 180 a second: that is the throughput. The
    server is busy 90% of the time: that is the utilisation. One request's latency is the time it
    spent waiting in the line plus the 5 ms of work, about 50 ms on average at this load.
  </desc>
  <defs>
    <marker id="lt-mm-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>

  <text x="4" y="22" font-size="16" font-weight="700" style="fill: var(--viz-ink)">arrive</text>
  <text x="4" y="42" font-size="15" style="fill: var(--viz-muted)">180 / s, at random</text>

  <text x="140" y="22" font-size="16" font-weight="700" style="fill: var(--viz-ink)">wait in line</text>
  <text x="140" y="42" font-size="15" style="fill: var(--viz-muted)">the queue</text>

  <text x="396" y="166" font-size="16" font-weight="700" text-anchor="end" style="fill: var(--viz-ok)">done</text>
  <text x="396" y="184" font-size="15" text-anchor="end" style="fill: var(--viz-muted)">180 / s</text>

  <line x1="10" y1="96" x2="128" y2="96" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#lt-mm-a)" />
  <circle cx="24" cy="96" r="7" style="fill: var(--viz-flow)" />
  <circle cx="60" cy="96" r="7" style="fill: var(--viz-flow)" />

  <rect {...box(132, 72, 116, 48)} rx="4" stroke-width="2" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  {waiting.map((i) => <rect x={140 + i * 26} y="82" width="20" height="28" rx="3" style="fill: var(--viz-warn)" />)}

  <line x1="249" y1="96" x2="266" y2="96" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#lt-mm-a)" />
  <rect {...box(270, 62, 84, 68)} rx="6" stroke-width="2.5" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="312" y="90" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">server</text>
  <text x="312" y="112" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">5 ms each</text>
  <line x1="355" y1="96" x2="392" y2="96" stroke-width="2" style="stroke: var(--viz-ok)" marker-end="url(#lt-mm-a)" />

  <path d="M132 136 h116" stroke-width="2" style="stroke: var(--viz-warn)" />
  <path d="M270 136 h84" stroke-width="2" style="stroke: var(--viz-server)" />
  <path d="M132 130 v12 M248 130 v12 M270 130 v12 M354 130 v12" stroke-width="1.5" style="stroke: var(--viz-muted)" />
  <text x="190" y="160" font-size="15" text-anchor="middle" style="fill: var(--viz-warn)">waiting</text>
  <text x="312" y="160" font-size="15" text-anchor="middle" style="fill: var(--viz-server)">work</text>

  <rect {...box(4, 208, 392, 50)} rx="8" stroke-width="1.5" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" />
  <text x="16" y="230" font-size="16" font-weight="700" style="fill: var(--viz-ink)">latency = waiting + work</text>
  <text x="16" y="250" font-size="15" style="fill: var(--viz-muted)">what one user feels: here about 50 ms</text>

  <rect {...box(4, 266, 392, 50)} rx="8" stroke-width="1.5" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" />
  <text x="16" y="288" font-size="16" font-weight="700" style="fill: var(--viz-ink)">throughput = finished per second</text>
  <text x="16" y="308" font-size="15" style="fill: var(--viz-muted)">what the server carries: 180 / s, at most 200</text>

  <rect {...box(4, 324, 392, 50)} rx="8" stroke-width="1.5" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" />
  <text x="16" y="346" font-size="16" font-weight="700" style="fill: var(--viz-ink)">utilisation = how busy the server is</text>
  <text x="16" y="366" font-size="15" style="fill: var(--viz-muted)">180 × 5 ms = 900 ms of work a second: 90%</text>
</svg>
