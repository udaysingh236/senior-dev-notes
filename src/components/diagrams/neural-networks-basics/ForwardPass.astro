---
// Part 2 forward pass: 3 inputs -> 2 hidden ReLU neurons -> 1 sigmoid output, with the numbers.
const inputs = [
  { y: 70, v: '6', l: 'links' },
  { y: 150, v: '4', l: 'money' },
  { y: 230, v: '0', l: 'known' },
];
const hid = [
  { y: 90, n: 'A', s: '2.2', o: '2.2', on: true },
  { y: 210, n: 'B', s: '−0.9', o: '0', on: false },
];
const OUT = { x: 330, y: 150 };
---

<svg viewBox="0 0 400 330" width="100%" role="img" aria-labelledby="nnb-fp-t nnb-fp-d">
  <title id="nnb-fp-t">A forward pass through a 3, 2, 1 network</title>
  <desc id="nnb-fp-d">
    Three inputs, 6 links, 4 money words and 0 for known sender, feed two hidden neurons. Neuron A's score is 2.2 and
    ReLU keeps it: 2.2. Neuron B's score is minus 0.9 and ReLU turns it into 0, so B is off for this email. The output
    neuron adds 1.5 times 2.2 and minus 2 times 0 and a bias of minus 2, giving 1.3, which the sigmoid turns into 0.786.
  </desc>
  {inputs.map((i) => hid.map((h) => (
    <line x1="56" y1={i.y} x2="160" y2={h.y} stroke-width="1.5" style="stroke: var(--viz-stroke)" />
  )))}
  <line x1="236" y1="90" x2={OUT.x - 30} y2={OUT.y} stroke-width="3" style="stroke: var(--viz-flow)" />
  <line x1="236" y1="210" x2={OUT.x - 30} y2={OUT.y} stroke-width="1.5" stroke-dasharray="4 4" style="stroke: var(--viz-stroke)" />
  <text x="270" y="104" font-size="14" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">×1.5</text>
  <text x="268" y="206" font-size="14" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">×−2</text>
  {inputs.map((i) => (
    <g>
      <circle cx="36" cy={i.y} r="20" stroke-width="2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
      <text x="36" y={i.y + 6} font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">{i.v}</text>
      <text x="36" y={i.y + 40} font-size="14" text-anchor="middle" style="fill: var(--viz-muted)">{i.l}</text>
    </g>
  ))}
  {hid.map((h) => (
    <g>
      <rect x="160" y={h.y - 34} width="76" height="68" rx="10" stroke-width="2" style={h.on ? 'fill: var(--viz-ok-soft); stroke: var(--viz-ok)' : 'fill: var(--viz-surface); stroke: var(--viz-stroke)'} />
      <text x="198" y={h.y - 12} font-size="15" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">{h.n}</text>
      <text x="198" y={h.y + 8} font-size="15" text-anchor="middle" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">{h.s}</text>
      <text x="198" y={h.y + 27} font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">→ {h.o}</text>
    </g>
  ))}
  <text x="198" y="266" font-size="14" text-anchor="middle" style="fill: var(--viz-muted)">B is off (ReLU)</text>
  <rect x={OUT.x - 30} y={OUT.y - 34} width="96" height="68" rx="10" stroke-width="2" style="fill: var(--viz-bad-soft); stroke: var(--viz-bad)" />
  <text x={OUT.x + 18} y={OUT.y - 12} font-size="15" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">output</text>
  <text x={OUT.x + 18} y={OUT.y + 8} font-size="15" text-anchor="middle" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">1.3</text>
  <text x={OUT.x + 18} y={OUT.y + 27} font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">→ 0.786</text>
  <text x="4" y="300" font-size="15" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">1.5 × 2.2 + (−2) × 0 − 2 = 1.3</text>
  <text x="4" y="322" font-size="15" style="fill: var(--viz-muted)">each box: score, then → after its squash</text>
</svg>
