---
// Gradient descent on one weight: the loss as a valley, small steps downhill, and a step that is too big.
const X0 = 20, X1 = 390, Y0 = 220, Y1 = 40;
const W0 = -0.8, W1 = 2.4; // weight range across
const loss = (w: number) => 0.5 * (w - 0.8) ** 2 + 0.05;
const LMAX = loss(W0) + 0.05;
const sx = (w: number) => X0 + ((w - W0) / (W1 - W0)) * (X1 - X0);
const sy = (l: number) => Y0 - (l / LMAX) * (Y0 - Y1);
const curve: string[] = [];
for (let w = W0; w <= W1 + 1e-9; w += 0.05) curve.push(`${sx(w).toFixed(1)},${sy(loss(w)).toFixed(1)}`);
// Small steps: w ← w − 0.5 × slope, slope = w − 0.8
const good = [-0.6, 0.1, 0.45, 0.625];
// Too big: w ← w − 1.9 × slope
const bad = [-0.6, 2.06, -0.334, 1.82];
---

<svg viewBox="0 0 400 300" width="100%" role="img" aria-labelledby="nnb-lv-t nnb-lv-d">
  <title id="nnb-lv-t">Gradient descent: walking downhill on the loss</title>
  <desc id="nnb-lv-d">
    A U-shaped curve: the loss for every value of one weight. The lowest point is the best value. Blue dots show
    gradient descent with small steps: each step goes downhill, and the steps get shorter as the slope flattens near
    the bottom. Dashed amber arrows show steps that are too big: they jump across the valley from side to side and
    never settle at the bottom.
  </desc>
  <defs>
    <marker id="nnb-lv-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="nnb-lv-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-warn)" />
    </marker>
  </defs>
  <text x={X0} y="22" font-size="15" style="fill: var(--viz-muted)">loss: how wrong ↑</text>
  <line x1={X0} y1={Y0} x2={X1} y2={Y0} stroke-width="1.5" style="stroke: var(--viz-stroke)" />
  <text x={X1} y={Y0 + 22} font-size="15" text-anchor="end" style="fill: var(--viz-muted)">value of one weight →</text>
  <polyline points={curve.join(' ')} fill="none" stroke-width="3" style="stroke: var(--viz-stroke)" />
  <line x1={sx(0.8)} y1={sy(loss(0.8)) + 8} x2={sx(0.8)} y2={Y0} stroke-width="1" stroke-dasharray="3 4" style="stroke: var(--viz-ok)" />
  <text x={sx(0.8)} y={Y0 + 22} font-size="15" text-anchor="middle" style="fill: var(--viz-ok)">best</text>

  {bad.slice(0, -1).map((w, i) => (
    <path d={`M ${sx(w)} ${sy(loss(w))} Q ${(sx(w) + sx(bad[i + 1])) / 2} ${sy(loss(w)) - 60 + i * 10} ${sx(bad[i + 1])} ${sy(loss(bad[i + 1])) - 6}`}
      fill="none" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-warn)" marker-end="url(#nnb-lv-w)" />
  ))}
  {good.slice(0, -1).map((w, i) => (
    <line x1={sx(w) + 6} y1={sy(loss(w)) + 4} x2={sx(good[i + 1]) - 7} y2={sy(loss(good[i + 1])) - 3} stroke-width="2.5" style="stroke: var(--viz-flow)" marker-end="url(#nnb-lv-a)" />
  ))}
  {good.map((w, i) => (
    <g>
      <circle cx={sx(w)} cy={sy(loss(w))} r="7" style="fill: var(--viz-flow)" />
      <text x={sx(w)} y={sy(loss(w)) + 26} font-size="14" font-weight="700" text-anchor="middle" style="fill: var(--viz-flow)">{i === 0 ? 'start' : ''}</text>
    </g>
  ))}
  <text x={X0} y="270" font-size="15" style="fill: var(--viz-flow)">● small steps: downhill, shorter as it flattens</text>
  <text x={X0} y="292" font-size="15" style="fill: var(--viz-warn)">- - steps too big: jump across, never settle</text>
</svg>
