---
// Password storage vs TOTP secret storage: one-way hash vs a secret the verifier must decrypt.
const col = [
  {
    x: 4,
    head: 'password',
    stored: ['argon2id hash', '+ salt'],
    step: 'hash what was typed',
    check: ['hash(typed)', '= stored hash?'],
    leak: ['leaked: crack each', 'hash, slowly'],
    tone: 'warn',
  },
  {
    x: 206,
    head: 'TOTP secret',
    stored: ['encrypted secret', 'data key wrapped'],
    step: 'decrypt via KMS',
    check: ['HMAC(secret, T)', '= typed code?'],
    leak: ['leaked with key: every', 'code, forever'],
    tone: 'bad',
  },
];
---

<svg viewBox="0 0 400 356" width="100%" role="img" aria-labelledby="ga-ss-t ga-ss-d">
  <title id="ga-ss-t">Why a TOTP secret cannot be stored like a password</title>
  <desc id="ga-ss-d">
    Two columns. Password: the server stores an argon2id hash with a salt, hashes what the user
    typed and compares the hashes; a leaked table must be cracked one hash at a time, slowly. TOTP
    secret: the server stores the secret encrypted, with its data key wrapped by a KMS master key;
    to check a code it decrypts the secret and computes HMAC of the secret and the current step, then
    compares with the typed code; a leaked table together with the key gives every user's codes
    forever.
  </desc>
  <defs>
    <marker id="ga-ss-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>
  {
    col.map((c) => (
      <g>
        <text x={c.x + 95} y="20" font-size="17" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">
          {c.head}
        </text>
        <path d={`M${c.x} 42 a95 9 0 0 1 190 0 v52 a95 9 0 0 1 -190 0 z`} stroke-width="2" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" />
        <path d={`M${c.x} 42 a95 9 0 0 0 190 0`} fill="none" stroke-width="2" style="stroke: var(--viz-store)" />
        <text x={c.x + 95} y="74" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">{c.stored[0]}</text>
        <text x={c.x + 95} y="95" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">{c.stored[1]}</text>

        <line x1={c.x + 30} y1="106" x2={c.x + 30} y2="144" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#ga-ss-a)" />
        <text x={c.x + 40} y="131" font-size="14" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">{c.step}</text>

        <rect x={c.x} y="150" width="190" height="62" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
        <text x={c.x + 95} y="176" font-size="16" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">{c.check[0]}</text>
        <text x={c.x + 95} y="199" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">{c.check[1]}</text>

        <rect
          x={c.x}
          y="236"
          width="190"
          height="62"
          rx="6"
          stroke-width="2"
          style={c.tone === 'bad' ? 'fill: var(--viz-bad-soft); stroke: var(--viz-bad)' : 'fill: var(--viz-warn-soft); stroke: var(--viz-warn)'}
        />
        <text x={c.x + 95} y="262" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">{c.leak[0]}</text>
        <text x={c.x + 95} y="284" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">{c.leak[1]}</text>
      </g>
    ))
  }
  <text x="4" y="326" font-size="15" style="fill: var(--viz-muted)">The verifier needs the secret itself, so only</text>
  <text x="4" y="348" font-size="15" style="fill: var(--viz-muted)">encryption is possible, never a one-way hash.</text>
</svg>
