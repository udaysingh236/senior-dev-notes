---
// The fields of a real certificate: example.com's, as served on 18 October 2026.
const rows: { label: string; lines: string[]; strong?: boolean }[] = [
  { label: 'Subject', lines: ['example.com'] },
  { label: 'Names', lines: ['example.com, *.example.com'], strong: true },
  { label: 'Issuer', lines: ['Cloudflare TLS Issuing', 'ECC CA 3 (SSL.com)'] },
  { label: 'Valid', lines: ['26 Sep to 25 Dec 2026', '(90 days)'], strong: true },
  { label: 'Public key', lines: ['ECDSA P-256'] },
  { label: 'May be used', lines: ['as a server, not as a CA'] },
  { label: 'CT', lines: ['2 timestamps from', 'public logs'] },
  { label: 'Signature', lines: ["by the issuer's key"], strong: true },
];
const TOP = 52;
let y = TOP;
const laid = rows.map((r) => {
  const row = { ...r, y };
  y += 14 + r.lines.length * 22;
  return row;
});
const HEIGHT = y + 62;
---

<svg viewBox={`0 0 400 ${HEIGHT}`} width="100%" role="img" aria-labelledby="tls-cert-t tls-cert-d">
  <title id="tls-cert-t">The fields of example.com's certificate</title>
  <desc id="tls-cert-d">
    A certificate is a signed card. Subject: example.com. Names it is valid for: example.com and
    any single label under it. Issuer: Cloudflare TLS Issuing ECC CA 3, run by SSL.com. Valid from
    26 September to 25 December 2026, 90 days. Public key: ECDSA P-256. May be used as a server,
    not as a certificate authority. Two timestamps from public Certificate Transparency logs. And
    the issuer's signature over all of it. The matching private key is not in the certificate.
  </desc>

  <rect x="4" y="4" width="392" height={HEIGHT - 58} rx="10" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" />
  <rect x="4" y="4" width="392" height="36" rx="10" style="fill: var(--viz-server-soft)" />
  <text x="16" y="29" font-size="18" font-weight="700" style="fill: var(--viz-ink)">Certificate <tspan font-weight="400" style="fill: var(--viz-muted)">(X.509)</tspan></text>

  {
    laid.map((r) => (
      <g>
        <text x="16" y={r.y + 18} font-size="16" font-weight="700" style="fill: var(--viz-muted)">{r.label}</text>
        {r.lines.map((line, k) => (
          <text x="130" y={r.y + 18 + k * 22} font-size="17" font-weight={r.strong ? 700 : 400} style="fill: var(--viz-ink)">{line}</text>
        ))}
      </g>
    ))
  }

  <text x="4" y={HEIGHT - 30} font-size="17" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">public: anyone can download it. The</text>
  <text x="4" y={HEIGHT - 8} font-size="17" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">private key never leaves the server.</text>
</svg>
