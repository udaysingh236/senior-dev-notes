---
// Read-your-writes on a timeline. At 0 ms the customer saves a new address on the leader. At 5 ms
// their page reloads and reads from follower B, which has not yet received the change and returns
// the old address. At 40 ms B applies the change; a read at 45 ms returns the new one.
---

<svg viewBox="0 0 400 318" width="100%" role="img" aria-labelledby="rep-ryw-t rep-ryw-d">
  <title id="rep-ryw-t">A read from a follower 5 ms after a write returns the old address</title>
  <desc id="rep-ryw-d">
    A timeline from 0 to 60 milliseconds with three rows. Customer row: at 0 ms they save the
    address Mumbai; at 5 ms they read it back from follower B and see the old address, Pune; at
    45 ms they read again and see Mumbai. Leader row: the change becomes log entry 2001 at 0 ms.
    Follower B row: entry 2001 arrives and is applied at 40 ms. Between 0 and 40 ms follower B is
    behind, shaded.
  </desc>
  <defs>
    <marker id="rep-ryw-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>

  <!-- row labels -->
  <g font-size="16" font-weight="700" style="fill: var(--viz-ink)">
    <text x="4" y="78">Customer</text>
    <text x="4" y="164">Leader</text>
    <text x="4" y="244">Follower B</text>
  </g>
  <g stroke-width="1.5" style="stroke: var(--viz-stroke)">
    <line x1="100" y1="72" x2="396" y2="72" />
    <line x1="100" y1="158" x2="396" y2="158" />
    <line x1="100" y1="238" x2="396" y2="238" />
  </g>

  <!-- lag band on follower B: 0 to 40 ms (x = 110 + t * 4.6) -->
  <rect x="110" y="226" width="184" height="24" rx="3" style="fill: var(--viz-warn-soft)" />
  <text x="202" y="272" font-size="15" text-anchor="middle" style="fill: var(--viz-warn)">behind: still says Pune</text>

  <!-- write at 0 ms -->
  <circle cx="110" cy="72" r="6" style="fill: var(--viz-flow)" />
  <text x="110" y="50" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">save Mumbai</text>
  <path d="M110 80 L 110 148" fill="none" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#rep-ryw-a)" />
  <circle cx="110" cy="158" r="6" style="fill: var(--viz-flow)" />
  <text x="122" y="148" font-size="15" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">entry 2001</text>
  <!-- shipped to B, arrives 40 ms -->
  <path d="M116 162 L 290 232" fill="none" stroke-width="2" stroke-dasharray="5 4" style="stroke: var(--viz-flow)" marker-end="url(#rep-ryw-a)" />
  <circle cx="294" cy="238" r="6" style="fill: var(--viz-ok)" />

  <!-- read at 5 ms: stale -->
  <circle cx="133" cy="72" r="6" style="fill: var(--viz-bad)" />
  <text x="128" y="100" font-size="15" style="fill: var(--viz-bad)">read at 5 ms:</text>
  <text x="128" y="120" font-size="15" font-weight="700" style="fill: var(--viz-bad)">Pune (old)</text>

  <!-- read at 45 ms: fresh -->
  <circle cx="317" cy="72" r="6" style="fill: var(--viz-ok)" />
  <text x="396" y="100" font-size="15" text-anchor="end" style="fill: var(--viz-ok)">read at 45 ms:</text>
  <text x="396" y="120" font-size="15" font-weight="700" text-anchor="end" style="fill: var(--viz-ok)">Mumbai</text>

  <!-- time axis -->
  <line x1="110" y1="290" x2="396" y2="290" stroke-width="1.5" style="stroke: var(--viz-muted)" />
  <g font-size="15" text-anchor="middle" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">
    <text x="110" y="312">0</text>
    <text x="202" y="312">20</text>
    <text x="294" y="312">40</text>
    <text x="376" y="312">60 ms</text>
  </g>
</svg>
