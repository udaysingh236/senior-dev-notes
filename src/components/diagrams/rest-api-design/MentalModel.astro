---
// Part 1 mental model: one app talks to one shop API. Three moments when the app cannot be sure
// what happened, and the HTTP rule that settles each one.
const box = (x: number, y: number, w: number, h: number) => ({ x, y, width: w, height: h });
const CARD = 86;
const TOP = 160;
const cards = [
  {
    n: '1',
    tone: 'flow',
    head: 'The answer never arrived',
    lines: ['send it again with the same key;', 'the server replays its first answer'],
  },
  {
    n: '2',
    tone: 'warn',
    head: 'Someone saved since you read',
    lines: ['save “only if still version v3”;', 'if not: 412, read again and redo'],
  },
  {
    n: '3',
    tone: 'ok',
    head: 'The response has something new',
    lines: ['the server only adds things;', 'the old app ignores what it does not know'],
  },
];
---

<svg viewBox={`0 0 400 ${TOP + cards.length * (CARD + 10) - 6}`} width="100%" role="img" aria-labelledby="rad-mm-t rad-mm-d">
  <title id="rad-mm-t">One app, one shop API, three moments of doubt</title>
  <desc id="rad-mm-d">
    At the top, your app (the client) sends a request to the shop API (the server) and waits for a
    response. Below, three moments when the app cannot be sure what happened, each with the rule
    that settles it. One: the answer never arrived; the app sends the request again with the same
    key, and the server replays its first answer instead of doing the work twice. Two: someone saved
    the data since the app read it; the app saves only if the data is still at version v3, and if it
    is not, the server answers 412, and the app reads the new version and makes its change again.
    Three: the response has something new; the server only adds things, and the old app ignores
    what it does not know.
  </desc>
  <defs>
    <marker id="rad-mm-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>

  <text x="4" y="18" font-size="15" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">one app, one shop API</text>

  <rect {...box(4, 40, 124, 64)} rx="14" stroke-width="2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
  <text x="66" y="68" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">your app</text>
  <text x="66" y="90" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">the client</text>

  <rect {...box(272, 40, 124, 64)} rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="334" y="68" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">shop API</text>
  <text x="334" y="90" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">the server</text>

  <text x="200" y="54" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">request</text>
  <line x1="130" y1="62" x2="268" y2="62" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#rad-mm-a)" />
  <line x1="268" y1="82" x2="132" y2="82" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-flow)" marker-end="url(#rad-mm-a)" />
  <text x="200" y="100" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">response</text>

  <text x="4" y="142" font-size="15" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">three moments when the app cannot be sure</text>

  {
    cards.map((c, i) => {
      const y = TOP + i * (CARD + 10);
      return (
        <g>
          <rect {...box(4, y, 392, CARD)} rx="8" stroke-width="1.5" style={`fill: var(--viz-surface); stroke: var(--viz-${c.tone})`} />
          <circle cx="26" cy={y + 25} r="13" stroke-width="2" style={`fill: var(--viz-${c.tone}-soft); stroke: var(--viz-${c.tone})`} />
          <text x="26" y={y + 30} font-size="15" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">{c.n}</text>
          <text x="48" y={y + 30} font-size="16" font-weight="700" style="fill: var(--viz-ink)">{c.head}</text>
          {c.lines.map((line, k) => (
            <text x="48" y={y + 54 + k * 20} font-size="15" style="fill: var(--viz-muted)">{line}</text>
          ))}
        </g>
      );
    })
  }
</svg>
