---
// Status codes grouped by what a client program should do next, which is what they are for.
const groups = [
  { action: 'Wait, then retry the same request', codes: ['429', '503', '502*', '504*'], tone: 'ok' },
  { action: 'Read again, then retry', codes: ['409', '412'], tone: 'flow' },
  { action: 'Get new credentials', codes: ['401'], tone: 'client' },
  { action: 'Fix the request; retrying won\'t help', codes: ['400', '404', '405', '415', '422'], tone: 'warn' },
  { action: 'Stop', codes: ['403', '410'], tone: 'bad' },
];
const ROW = 70;
---

<svg viewBox={`0 0 400 ${groups.length * ROW + 30}`} width="100%" role="img" aria-labelledby="rad-sa-t rad-sa-d">
  <title id="rad-sa-t">Status codes grouped by what the client should do</title>
  <desc id="rad-sa-d">
    Five groups. Wait, then retry the same request: 429, 503, and 502 or 504 for idempotent requests.
    Read again, then retry: 409 and 412. Get new credentials: 401. Fix the request, because retrying
    will not help: 400, 404, 405, 415 and 422. Stop: 403 and 410.
  </desc>
  {
    groups.map((g, i) => {
      const y = i * ROW + 4;
      return (
        <g>
          <text x="4" y={y + 18} font-size="16" font-weight="700" style="fill: var(--viz-ink)">{g.action}</text>
          {g.codes.map((c, k) => (
            <g>
              <rect x={4 + k * 66} y={y + 28} width="58" height="30" rx="15" stroke-width="1.5" style={`fill: var(--viz-${g.tone}-soft); stroke: var(--viz-${g.tone})`} />
              <text x={33 + k * 66} y={y + 48} font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">{c}</text>
            </g>
          ))}
        </g>
      );
    })
  }
  <text x="4" y={groups.length * ROW + 22} font-size="15" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">* only for idempotent requests, or with a key</text>
</svg>
