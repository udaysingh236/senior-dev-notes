---
// The two things "leaky bucket" means: a queue that drains at a fixed rate, and a meter that
// fills per request and drains at a fixed rate.
---

<svg viewBox="0 0 400 330" width="100%" role="img" aria-labelledby="rl-lb-t rl-lb-d">
  <title id="rl-lb-t">Leaky bucket as a queue and as a meter</title>
  <desc id="rl-lb-d">
    Top: the leaky bucket as a queue. Requests join a queue of six slots, four of them full, and
    leave it towards the API at one per second. A request that finds the queue full is rejected.
    Bottom: the leaky bucket as a meter. Each request raises a level by one; the level drains at
    one per second. If there is room the request is answered immediately; if the level is at the
    top, it is rejected.
  </desc>
  <defs>
    <marker id="rl-lb-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="rl-lb-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
    <marker id="rl-lb-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-muted)" />
    </marker>
  </defs>

  <!-- As a queue -->
  <text x="8" y="26" font-size="19" font-weight="700" style="fill: var(--viz-ink)">As a queue: wait your turn</text>
  <g style="fill: var(--viz-flow)">
    <circle cx="20" cy="72" r="6" />
    <circle cx="38" cy="72" r="6" />
    <circle cx="56" cy="72" r="6" />
  </g>
  <line x1="68" y1="72" x2="102" y2="72" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#rl-lb-flow)" />
  <g stroke-width="1.5">
    <rect x="106" y="52" width="28" height="40" rx="3" fill="none" style="stroke: var(--viz-stroke)" />
    <rect x="138" y="52" width="28" height="40" rx="3" fill="none" style="stroke: var(--viz-stroke)" />
    <rect x="170" y="52" width="28" height="40" rx="3" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
    <rect x="202" y="52" width="28" height="40" rx="3" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
    <rect x="234" y="52" width="28" height="40" rx="3" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
    <rect x="266" y="52" width="28" height="40" rx="3" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  </g>
  <line x1="298" y1="72" x2="346" y2="72" stroke-width="2" style="stroke: var(--viz-ok)" marker-end="url(#rl-lb-ok)" />
  <text x="392" y="78" font-size="19" font-weight="600" text-anchor="end" style="fill: var(--viz-ink)">API</text>
  <text x="200" y="120" font-size="19" text-anchor="middle" style="fill: var(--viz-muted)">leaves at 1 per second</text>
  <text x="200" y="146" font-size="19" text-anchor="middle" style="fill: var(--viz-bad)">full queue: rejected</text>

  <line x1="8" y1="170" x2="392" y2="170" stroke-width="1" style="stroke: var(--viz-stroke)" />

  <!-- As a meter -->
  <text x="8" y="200" font-size="19" font-weight="700" style="fill: var(--viz-ink)">As a meter: answer now</text>
  <text x="8" y="246" font-size="19" style="fill: var(--viz-muted)">each request</text>
  <text x="8" y="270" font-size="19" style="fill: var(--viz-muted)">adds 1</text>
  <rect x="150" y="218" width="60" height="84" rx="4" fill="none" stroke-width="2" style="stroke: var(--viz-server)" />
  <rect x="152" y="252" width="56" height="48" rx="2" style="fill: var(--viz-flow-soft)" />
  <line x1="150" y1="252" x2="210" y2="252" stroke-width="2" style="stroke: var(--viz-flow)" />
  <line x1="180" y1="304" x2="180" y2="322" stroke-width="2" style="stroke: var(--viz-muted)" marker-end="url(#rl-lb-muted)" />
  <text x="194" y="324" font-size="19" style="fill: var(--viz-muted)">drains 1/s</text>
  <g font-size="19">
    <circle cx="232" cy="236" r="7" style="fill: var(--viz-ok)" />
    <text x="246" y="242" style="fill: var(--viz-ink)">room: 200</text>
    <path d="M226 260 l12 12 M238 260 l-12 12" stroke-width="3" stroke-linecap="round" style="stroke: var(--viz-bad)" />
    <text x="246" y="272" style="fill: var(--viz-ink)">full: 429</text>
  </g>
</svg>
