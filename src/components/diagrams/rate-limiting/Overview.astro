---
// Hero diagram: three kinds of client, one rate limiter that identifies, counts and decides,
// the API behind it, and the shared counters it keeps.
---

<svg viewBox="0 0 400 330" width="100%" role="img" aria-labelledby="rl-ov-t rl-ov-d">
  <title id="rl-ov-t">Where a rate limiter sits</title>
  <desc id="rl-ov-d">
    Three clients on the left, a web app, phones and a buggy script, send requests to a rate
    limiter in the middle. The limiter identifies each caller, counts its recent requests in a
    shared counter store below it, and decides. Allowed requests continue to the API on the right
    with a 200 response. The buggy script, which has used up its share, gets a 429 back.
  </desc>
  <defs>
    <marker id="rl-ov-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="rl-ov-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
    <marker id="rl-ov-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-bad)" />
    </marker>
    <marker id="rl-ov-store" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-store)" />
    </marker>
  </defs>

  <g font-size="19" font-weight="600" text-anchor="middle" style="fill: var(--viz-ink)">
    <!-- Clients -->
    <rect x="8" y="24" width="120" height="56" rx="14" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" stroke-width="2" />
    <text x="68" y="58">Web app</text>
    <rect x="8" y="104" width="120" height="56" rx="14" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" stroke-width="2" />
    <text x="68" y="138">Phones</text>
    <rect x="8" y="184" width="120" height="56" rx="14" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" stroke-width="2" />
    <text x="68" y="218">Bad script</text>

    <!-- The limiter -->
    <rect x="168" y="24" width="112" height="216" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="224" y="56">Rate</text>
    <text x="224" y="80">limiter</text>
    <g font-weight="400" text-anchor="start">
      <text x="182" y="128">1 key</text>
      <text x="182" y="166">2 count</text>
      <text x="182" y="204">3 decide</text>
    </g>

    <!-- API -->
    <rect x="320" y="104" width="72" height="56" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="356" y="138">API</text>

    <!-- Shared counters -->
    <path d="M174 272 a50 9 0 0 1 100 0 v40 a50 9 0 0 1 -100 0 z" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" stroke-width="2" />
    <path d="M174 272 a50 9 0 0 0 100 0" fill="none" style="stroke: var(--viz-store)" stroke-width="2" />
    <text x="224" y="304">Counters</text>
  </g>

  <!-- Requests in -->
  <g stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#rl-ov-flow)">
    <line x1="129" y1="46" x2="165" y2="46" />
    <line x1="129" y1="126" x2="165" y2="126" />
    <line x1="129" y1="202" x2="165" y2="202" />
  </g>

  <!-- Allowed on to the API -->
  <line x1="281" y1="132" x2="317" y2="132" stroke-width="2" style="stroke: var(--viz-ok)" marker-end="url(#rl-ov-ok)" />
  <text x="300" y="120" font-size="19" text-anchor="middle" style="fill: var(--viz-ok)">200</text>

  <!-- Rejected back to the script -->
  <line x1="166" y1="226" x2="131" y2="226" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-bad)" marker-end="url(#rl-ov-bad)" />
  <text x="148" y="264" font-size="19" font-weight="700" text-anchor="middle" style="fill: var(--viz-bad)">429</text>

  <!-- Limiter reads and updates the counters -->
  <line x1="224" y1="243" x2="224" y2="260" stroke-width="2" style="stroke: var(--viz-store)" marker-start="url(#rl-ov-store)" marker-end="url(#rl-ov-store)" />
</svg>
