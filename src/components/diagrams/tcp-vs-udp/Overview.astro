---
// The hero picture: the same five messages sent over TCP and over UDP. TCP is one ordered stream
// inside a connection, with ACKs coming back; UDP is separate datagrams that can be lost or
// arrive out of order, and nobody resends them.
---

<svg viewBox="0 0 400 372" width="100%" role="img" aria-labelledby="tu-ov-t tu-ov-d">
  <title id="tu-ov-t">TCP sends one ordered stream; UDP sends separate datagrams</title>
  <desc id="tu-ov-d">
    Two panels. Top, TCP: two applications joined by a pipe, the connection, set up before any
    data moves. Inside it, pieces 1 to 5 travel in order, and ACKs flow back saying how much has
    arrived. Anything lost is sent again, and the receiving application gets every byte in order.
    Bottom, UDP: the same two applications with no pipe. Datagrams 1, 2, 4 and 3 travel
    separately, 4 overtaking 3, and datagram 5 is lost on the way, marked with a red cross.
    Nobody resends it.
  </desc>
  <defs>
    <marker id="tu-ov-ack" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-muted)" />
    </marker>
    <marker id="tu-ov-warn" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-warn)" />
    </marker>
  </defs>

  <!-- ===== TCP ===== -->
  <text x="4" y="24" font-size="20" font-weight="700" style="fill: var(--viz-ink)">TCP</text>
  <text x="52" y="24" font-size="17" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">a connection, set up first</text>

  <g font-size="19" font-weight="700" text-anchor="middle">
    <rect x="4" y="42" width="66" height="56" rx="14" stroke-width="2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
    <text x="37" y="76" style="fill: var(--viz-ink)">App</text>
    <rect x="330" y="42" width="66" height="56" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
    <text x="363" y="76" style="fill: var(--viz-ink)">App</text>
  </g>

  <!-- The connection: one pipe, bytes in order -->
  <rect x="76" y="50" width="248" height="40" rx="20" stroke-width="2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
  <g font-size="18" font-weight="700" text-anchor="middle">
    <rect x="96" y="57" width="30" height="26" rx="4" style="fill: var(--viz-flow)" />
    <text x="111" y="76" style="fill: var(--viz-surface)">5</text>
    <rect x="140" y="57" width="30" height="26" rx="4" style="fill: var(--viz-flow)" />
    <text x="155" y="76" style="fill: var(--viz-surface)">4</text>
    <rect x="184" y="57" width="30" height="26" rx="4" style="fill: var(--viz-flow)" />
    <text x="199" y="76" style="fill: var(--viz-surface)">3</text>
    <rect x="228" y="57" width="30" height="26" rx="4" style="fill: var(--viz-flow)" />
    <text x="243" y="76" style="fill: var(--viz-surface)">2</text>
    <rect x="272" y="57" width="30" height="26" rx="4" style="fill: var(--viz-flow)" />
    <text x="287" y="76" style="fill: var(--viz-surface)">1</text>
  </g>

  <!-- ACKs flow back -->
  <line x1="320" y1="112" x2="84" y2="112" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-muted)" marker-end="url(#tu-ov-ack)" />
  <text x="200" y="134" font-size="17" text-anchor="middle" style="fill: var(--viz-muted)">ACK: "I have everything up to 1"</text>

  <g font-size="18" style="fill: var(--viz-ink)">
    <text x="4" y="164">Lost pieces are sent again. The app</text>
    <text x="4" y="186">gets every byte, in order, or an error.</text>
  </g>

  <line x1="4" y1="204" x2="396" y2="204" stroke-width="1" stroke-dasharray="2 6" style="stroke: var(--viz-stroke)" />

  <!-- ===== UDP ===== -->
  <text x="4" y="236" font-size="20" font-weight="700" style="fill: var(--viz-ink)">UDP</text>
  <text x="56" y="236" font-size="17" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">no setup, no connection</text>

  <g font-size="19" font-weight="700" text-anchor="middle">
    <rect x="4" y="254" width="66" height="56" rx="14" stroke-width="2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
    <text x="37" y="288" style="fill: var(--viz-ink)">App</text>
    <rect x="330" y="254" width="66" height="56" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
    <text x="363" y="288" style="fill: var(--viz-ink)">App</text>
  </g>

  <!-- Separate datagrams: 5 lost, 4 overtakes 3 -->
  <g font-size="18" font-weight="700" text-anchor="middle">
    <rect x="94" y="269" width="30" height="26" rx="3" stroke-width="2" stroke-dasharray="4 3" style="fill: none; stroke: var(--viz-bad)" />
    <path d="M100 274 l18 16 M118 274 l-18 16" stroke-width="3" style="stroke: var(--viz-bad)" />
    <rect x="150" y="276" width="30" height="26" rx="3" stroke-width="2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
    <text x="165" y="295" style="fill: var(--viz-ink)">3</text>
    <rect x="200" y="262" width="30" height="26" rx="3" stroke-width="2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
    <text x="215" y="281" style="fill: var(--viz-ink)">4</text>
    <rect x="248" y="270" width="30" height="26" rx="3" stroke-width="2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
    <text x="263" y="289" style="fill: var(--viz-ink)">2</text>
    <rect x="290" y="268" width="30" height="26" rx="3" stroke-width="2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
    <text x="305" y="287" style="fill: var(--viz-ink)">1</text>
  </g>
  <!-- 4 overtakes 3 -->
  <path d="M168 270 C 176 252, 196 250, 204 258" fill="none" stroke-width="1.5" style="stroke: var(--viz-warn)" marker-end="url(#tu-ov-warn)" />
  <g font-size="16" font-style="italic" style="font-family: var(--note-font-display)">
    <text x="109" y="326" text-anchor="middle" style="fill: var(--viz-bad)">5 lost</text>
    <text x="190" y="326" text-anchor="middle" style="fill: var(--viz-warn)">4 overtakes 3</text>
  </g>

  <g font-size="18" style="fill: var(--viz-ink)">
    <text x="4" y="354">Nobody resends, reorders or slows down.</text>
  </g>
</svg>
