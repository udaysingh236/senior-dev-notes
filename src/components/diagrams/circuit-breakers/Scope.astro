---
// Breaker scope. Reviews runs on four servers and one of them is dead. Top: one breaker for all of
// Reviews sees 25% failures and must choose between paying the timeout on 1 call in 4 and cutting
// off all four servers. Bottom: one breaker per server (or a load balancer that ejects the bad
// server) cuts off only server 3.
const servers = [1, 2, 3, 4];
---

<svg viewBox="0 0 400 470" width="100%" role="img" aria-labelledby="cb-sc-t cb-sc-d">
  <title id="cb-sc-t">One breaker for a whole service versus one per server</title>
  <desc id="cb-sc-d">
    Reviews runs on four servers and server 3 stops answering. Top: Product has one breaker for all
    of Reviews. It sees 1 call in 4 fail. At a 50% threshold it stays closed and 1 call in 4 still
    waits the full timeout; at a 20% threshold it opens and cuts off the three healthy servers too.
    Bottom: Product has one breaker per server. Only the breaker for server 3 opens, and calls go to
    servers 1, 2 and 4.
  </desc>
  <defs>
    <marker id="cb-sc-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>

  <text x="4" y="22" font-size="17" font-weight="700" style="fill: var(--viz-ink)">One breaker for all of Reviews</text>
  <rect x="4" y="60" width="90" height="70" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="49" y="100" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">Product</text>
  <line x1="96" y1="95" x2="118" y2="95" stroke-width="2" style="stroke: var(--viz-flow)" />
  <rect x="118" y="78" width="74" height="34" rx="17" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-warn)" />
  <text x="155" y="100" font-size="15" font-weight="700" text-anchor="middle" style="fill: var(--viz-warn)">25% ✗</text>
  {servers.map((s, i) => (
    <g>
      <line x1="194" y1="95" x2="282" y2={46 + i * 34} stroke-width="1.5" style="stroke: var(--viz-flow)" marker-end="url(#cb-sc-a)" />
      <rect x="286" y={32 + i * 34} width="110" height="28" rx="4" stroke-width="1.5"
        stroke-dasharray={s === 3 ? '5 2' : undefined}
        style={s === 3 ? 'fill: var(--viz-bad-soft); stroke: var(--viz-bad)' : 'fill: var(--viz-ok-soft); stroke: var(--viz-ok)'} />
      <text x="341" y={52 + i * 34} font-size="15" text-anchor="middle" style={s === 3 ? 'fill: var(--viz-bad)' : 'fill: var(--viz-ink)'}>{s === 3 ? 'server 3: dead' : `server ${s}`}</text>
    </g>
  ))}
  <text x="4" y="196" font-size="15" style="fill: var(--viz-ink)">threshold 50%: stays closed, 1 call in 4</text>
  <text x="4" y="216" font-size="15" style="fill: var(--viz-ink)">still waits the whole timeout</text>
  <text x="4" y="240" font-size="15" style="fill: var(--viz-bad)">threshold 20%: opens, and cuts off the</text>
  <text x="4" y="260" font-size="15" style="fill: var(--viz-bad)">3 healthy servers too</text>

  <line x1="4" y1="282" x2="396" y2="282" stroke-width="1" stroke-dasharray="3 4" style="stroke: var(--viz-stroke)" />

  <text x="4" y="310" font-size="17" font-weight="700" style="fill: var(--viz-ink)">One breaker per server</text>
  <rect x="4" y="350" width="90" height="70" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="49" y="390" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">Product</text>
  {servers.map((s, i) => {
    const y = 322 + i * 34;
    const dead = s === 3;
    return (
      <g>
        <line x1="96" y1="385" x2="140" y2={y + 14} stroke-width="1.5" style="stroke: var(--viz-flow)" />
        <rect x="140" y={y} width="76" height="28" rx="14" stroke-width="1.5" style={dead ? 'fill: var(--viz-surface); stroke: var(--viz-bad)' : 'fill: var(--viz-surface); stroke: var(--viz-ok)'} />
        <text x="178" y={y + 20} font-size="15" font-weight="700" text-anchor="middle" style={dead ? 'fill: var(--viz-bad)' : 'fill: var(--viz-ok)'}>{dead ? 'OPEN' : 'closed'}</text>
        <line x1="218" y1={y + 14} x2="282" y2={y + 14} stroke-width="1.5" stroke-dasharray={dead ? '3 4' : undefined} style={dead ? 'stroke: var(--viz-stroke)' : 'stroke: var(--viz-flow)'} marker-end={dead ? undefined : 'url(#cb-sc-a)'} />
        <rect x="286" y={y} width="110" height="28" rx="4" stroke-width="1.5"
          stroke-dasharray={dead ? '5 2' : undefined}
          style={dead ? 'fill: var(--viz-bad-soft); stroke: var(--viz-bad)' : 'fill: var(--viz-ok-soft); stroke: var(--viz-ok)'} />
        <text x="341" y={y + 20} font-size="15" text-anchor="middle" style={dead ? 'fill: var(--viz-bad)' : 'fill: var(--viz-ink)'}>{dead ? 'server 3: dead' : `server ${s}`}</text>
      </g>
    );
  })}
  <text x="4" y="462" font-size="15" font-weight="700" style="fill: var(--viz-ok)">only server 3 is cut off; 1, 2 and 4 serve</text>
</svg>
