---
// The three states of a circuit breaker and the four moves between them, with what each state
// does with a call. Thresholds are the running example's: last 20 calls, open at 50%, 5 s open.
---

<svg viewBox="0 0 400 470" width="100%" role="img" aria-labelledby="cb-sm-t cb-sm-d">
  <title id="cb-sm-t">The three states of a circuit breaker</title>
  <desc id="cb-sm-d">
    Closed: calls go through and each result is recorded. When at least half of the last 20 calls
    failed, the breaker moves to open. Open: calls are refused at once without being made. When 5
    seconds have passed, it moves to half-open. Half-open: one trial call goes through and the
    others are refused. If the trial succeeds, the breaker moves to closed; if it fails, back to
    open for another 5 seconds.
  </desc>
  <defs>
    <marker id="cb-sm-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ink)" />
    </marker>
  </defs>

  <!-- CLOSED -->
  <rect x="4" y="10" width="170" height="104" rx="14" stroke-width="2" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" />
  <text x="89" y="38" font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-ok)">CLOSED</text>
  <text x="89" y="64" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">calls go through</text>
  <text x="89" y="86" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">every result</text>
  <text x="89" y="104" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">is counted</text>

  <!-- OPEN -->
  <rect x="226" y="10" width="170" height="104" rx="14" stroke-width="2" style="fill: var(--viz-bad-soft); stroke: var(--viz-bad)" />
  <text x="311" y="38" font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-bad)">OPEN</text>
  <text x="311" y="64" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">calls refused</text>
  <text x="311" y="86" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">at once, none</text>
  <text x="311" y="104" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">is made</text>

  <!-- HALF-OPEN -->
  <rect x="115" y="320" width="170" height="104" rx="14" stroke-width="2" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  <text x="200" y="348" font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-warn)">HALF-OPEN</text>
  <text x="200" y="374" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">one trial call</text>
  <text x="200" y="396" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">goes through,</text>
  <text x="200" y="414" font-size="15" text-anchor="middle" style="fill: var(--viz-ink)">the rest refused</text>

  <!-- closed -> open -->
  <path d="M176 44 L224 44" fill="none" stroke-width="2" style="stroke: var(--viz-ink)" marker-end="url(#cb-sm-a)" />
  <text x="200" y="140" font-size="15" text-anchor="middle" style="fill: var(--viz-bad)">① 10 of the last 20</text>
  <text x="200" y="160" font-size="15" text-anchor="middle" style="fill: var(--viz-bad)">calls failed</text>
  <line x1="200" y1="122" x2="200" y2="50" stroke-width="1" stroke-dasharray="2 3" style="stroke: var(--viz-muted)" />

  <!-- open -> half-open -->
  <path d="M330 116 C 330 220, 300 290, 270 318" fill="none" stroke-width="2" style="stroke: var(--viz-ink)" marker-end="url(#cb-sm-a)" />
  <text x="396" y="214" font-size="15" text-anchor="end" style="fill: var(--viz-muted)">② 5 s have</text>
  <text x="396" y="234" font-size="15" text-anchor="end" style="fill: var(--viz-muted)">passed</text>

  <!-- half-open -> open -->
  <path d="M248 318 C 270 260, 285 190, 290 118" fill="none" stroke-width="2" style="stroke: var(--viz-bad)" marker-end="url(#cb-sm-a)" />
  <text x="226" y="262" font-size="15" text-anchor="end" style="fill: var(--viz-bad)">④ trial</text>
  <text x="226" y="282" font-size="15" text-anchor="end" style="fill: var(--viz-bad)">fails</text>

  <!-- half-open -> closed -->
  <path d="M140 318 C 100 260, 80 190, 80 118" fill="none" stroke-width="2" style="stroke: var(--viz-ok)" marker-end="url(#cb-sm-a)" />
  <text x="4" y="214" font-size="15" style="fill: var(--viz-ok)">③ trial</text>
  <text x="4" y="234" font-size="15" style="fill: var(--viz-ok)">succeeds</text>

  <text x="200" y="456" font-size="15" text-anchor="middle" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">"closed" means current flows, as in a home breaker</text>
</svg>
