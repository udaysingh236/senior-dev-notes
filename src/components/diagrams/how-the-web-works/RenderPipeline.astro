---
// The critical rendering path: HTML becomes the DOM, CSS becomes the CSSOM, the two combine into
// the render tree, and layout, paint and composite turn it into pixels. Every resource the HTML
// mentions is another trip through the network steps.
// The viewBox starts above 0 to leave room for the Figure's enlarge button over the top row.
---

<svg viewBox="0 -38 400 458" width="100%" role="img" aria-labelledby="hw-ren-t hw-ren-d">
  <title id="hw-ren-t">From bytes to pixels</title>
  <desc id="hw-ren-d">
    HTML is parsed into the DOM, a tree of every element. CSS is parsed into the CSSOM, a tree of
    style rules. The two combine into the render tree: only what will be shown, with its styles.
    Layout works out the size and position of every box, paint fills in the pixels, and
    composite stacks the painted layers onto the screen. Every image, script, stylesheet and font
    the HTML mentions starts another request through DNS, connect and ask.
  </desc>
  <defs>
    <marker id="hw-ren-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>

  <g font-size="19" text-anchor="middle" font-weight="700" style="fill: var(--viz-ink)">
    <!-- Inputs -->
    <rect x="6" y="6" width="176" height="46" rx="6" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" stroke-width="2" />
    <text x="94" y="36">HTML</text>
    <rect x="218" y="6" width="176" height="46" rx="6" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" stroke-width="2" />
    <text x="306" y="36">CSS</text>

    <!-- Trees -->
    <rect x="6" y="92" width="176" height="46" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="94" y="122">DOM</text>
    <rect x="218" y="92" width="176" height="46" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="306" y="122">CSSOM</text>

    <rect x="70" y="182" width="260" height="46" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="200" y="212">Render tree</text>

    <!-- To pixels -->
    <rect x="6" y="272" width="118" height="46" rx="6" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <text x="65" y="302">Layout</text>
    <rect x="141" y="272" width="118" height="46" rx="6" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <text x="200" y="302">Paint</text>
    <rect x="276" y="272" width="118" height="46" rx="6" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <text x="335" y="302">Composite</text>
  </g>

  <g stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#hw-ren-flow)">
    <line x1="94" y1="54" x2="94" y2="89" />
    <line x1="306" y1="54" x2="306" y2="89" />
    <line x1="94" y1="140" x2="150" y2="179" />
    <line x1="306" y1="140" x2="250" y2="179" />
    <line x1="200" y1="230" x2="80" y2="269" />
    <line x1="125" y1="295" x2="138" y2="295" />
    <line x1="260" y1="295" x2="273" y2="295" />
  </g>

  <!-- The loop back to the network -->
  <rect x="6" y="346" width="388" height="68" rx="8" stroke-dasharray="6 4" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-warn)" />
  <g font-size="19" text-anchor="middle">
    <text x="200" y="374" font-weight="700" style="fill: var(--viz-ink)">Each image, script and font in the HTML</text>
    <text x="200" y="400" style="fill: var(--viz-muted)">is another request: find, connect, ask</text>
  </g>
</svg>
