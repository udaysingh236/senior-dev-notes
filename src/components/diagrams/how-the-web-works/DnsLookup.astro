---
// A DNS lookup: three caches on your side (browser, OS, recursive resolver), and on a full miss
// the resolver's walk from the root to .com to the domain's own servers.
---

<svg viewBox="0 0 400 352" width="100%" role="img" aria-labelledby="hw-dns-t hw-dns-d">
  <title id="hw-dns-t">How a name becomes an address</title>
  <desc id="hw-dns-d">
    Top row, left to right: the browser, your operating system and a recursive resolver, each
    with its own cache. A question goes right until one of them has the answer. If the resolver
    does not know either, it asks three kinds of servers in turn, drawn on the bottom row:
    step 1, a root server, which refers it to the .com servers; step 2, a .com server, which
    refers it to the domain's own servers; step 3, the domain's servers, which give the address.
    The answer travels back to the browser, and every step caches it for its TTL.
  </desc>
  <defs>
    <marker id="hw-dns-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="hw-dns-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
  </defs>

  <!-- The answer, back to the browser -->
  <line x1="340" y1="30" x2="62" y2="30" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-ok)" marker-end="url(#hw-dns-ok)" />
  <text x="200" y="22" font-size="19" font-weight="600" text-anchor="middle" style="fill: var(--viz-ok)">answer: 104.20.23.154</text>

  <g font-size="19" text-anchor="middle">
    <!-- Your side: three caches -->
    <rect x="4" y="44" width="112" height="64" rx="14" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" stroke-width="2" />
    <text x="60" y="72" font-weight="700" style="fill: var(--viz-ink)">Browser</text>
    <text x="60" y="96" style="fill: var(--viz-muted)">cache</text>
    <rect x="144" y="44" width="112" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="200" y="72" font-weight="700" style="fill: var(--viz-ink)">Your OS</text>
    <text x="200" y="96" style="fill: var(--viz-muted)">cache</text>
    <rect x="284" y="44" width="112" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="340" y="72" font-weight="700" style="fill: var(--viz-ink)">Resolver</text>
    <text x="340" y="96" style="fill: var(--viz-muted)">cache</text>

    <!-- The servers that hold the truth -->
    <rect x="4" y="228" width="112" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="60" y="256" font-weight="700" style="fill: var(--viz-ink)">Root</text>
    <text x="60" y="280" style="fill: var(--viz-muted)">servers</text>
    <rect x="144" y="228" width="112" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="200" y="256" font-weight="700" style="fill: var(--viz-ink)">.com</text>
    <text x="200" y="280" style="fill: var(--viz-muted)">servers</text>
    <rect x="284" y="228" width="112" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="340" y="256" font-weight="700" style="fill: var(--viz-ink)">Domain's</text>
    <text x="340" y="280" style="fill: var(--viz-muted)">servers</text>
  </g>

  <!-- A miss moves the question right -->
  <g stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#hw-dns-flow)">
    <line x1="117" y1="84" x2="141" y2="84" />
    <line x1="257" y1="84" x2="281" y2="84" />
    <!-- The resolver's walk -->
    <line x1="318" y1="110" x2="68" y2="224" />
    <line x1="330" y1="110" x2="208" y2="224" />
    <line x1="340" y1="110" x2="340" y2="224" />
  </g>

  <!-- Step numbers on the walk -->
  <g font-size="19" font-weight="700" text-anchor="middle">
    <circle cx="150" cy="186" r="14" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-flow)" />
    <text x="150" y="193" style="fill: var(--viz-flow)">1</text>
    <circle cx="247" cy="186" r="14" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-flow)" />
    <text x="247" y="193" style="fill: var(--viz-flow)">2</text>
    <circle cx="340" cy="186" r="14" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-flow)" />
    <text x="340" y="193" style="fill: var(--viz-flow)">3</text>
  </g>

  <text x="200" y="336" font-size="19" text-anchor="middle" style="fill: var(--viz-muted)">Every answer is cached for its TTL</text>
</svg>
