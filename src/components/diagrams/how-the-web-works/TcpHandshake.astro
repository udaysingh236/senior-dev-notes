---
// The TCP three-way handshake as a timeline: time runs downwards, so each arrow slopes by half
// a round trip. The request can ride on the final ACK, so connecting costs one round trip.
// The viewBox starts above 0 to leave room for the Figure's enlarge button over the top row.
---

<svg viewBox="0 -38 400 360" width="100%" role="img" aria-labelledby="hw-tcp-t hw-tcp-d">
  <title id="hw-tcp-t">The TCP handshake costs one round trip</title>
  <desc id="hw-tcp-d">
    Time runs down the page. The browser, using a temporary port such as 51234, sends SYN to the
    server on port 443. The server answers SYN-ACK. The browser sends ACK and, in the same
    moment, its GET request. The server works briefly and sends back 200 OK. The first bracket
    marks one round trip spent only on connecting; the second marks the round trip of the
    request itself, plus the server's work.
  </desc>
  <defs>
    <marker id="hw-tcp-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="hw-tcp-server" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-server)" />
    </marker>
    <marker id="hw-tcp-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
  </defs>

  <g font-size="19" text-anchor="middle">
    <rect x="76" y="6" width="112" height="44" rx="14" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" stroke-width="2" />
    <text x="132" y="35" font-weight="700" style="fill: var(--viz-ink)">Browser</text>
    <rect x="282" y="6" width="112" height="44" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="338" y="35" font-weight="700" style="fill: var(--viz-ink)">Server</text>
    <text x="132" y="74" style="fill: var(--viz-muted)">port 51234</text>
    <text x="338" y="74" style="fill: var(--viz-muted)">port 443</text>
  </g>

  <!-- Lifelines -->
  <g stroke-width="1.5" stroke-dasharray="3 5" style="stroke: var(--viz-stroke)">
    <line x1="132" y1="82" x2="132" y2="316" />
    <line x1="338" y1="82" x2="338" y2="316" />
  </g>

  <!-- The handshake -->
  <g stroke-width="2">
    <line x1="132" y1="96" x2="334" y2="140" style="stroke: var(--viz-flow)" marker-end="url(#hw-tcp-flow)" />
    <line x1="338" y1="140" x2="136" y2="184" stroke-dasharray="6 4" style="stroke: var(--viz-server)" marker-end="url(#hw-tcp-server)" />
    <line x1="132" y1="184" x2="334" y2="228" style="stroke: var(--viz-flow)" marker-end="url(#hw-tcp-flow)" />
    <line x1="338" y1="250" x2="136" y2="294" stroke-dasharray="6 4" style="stroke: var(--viz-ok)" marker-end="url(#hw-tcp-ok)" />
  </g>
  <g font-size="19" font-weight="600" text-anchor="middle">
    <text x="214" y="106" style="fill: var(--viz-flow)">SYN</text>
    <text x="262" y="186" style="fill: var(--viz-server)">SYN-ACK</text>
    <text x="196" y="232" style="fill: var(--viz-flow)">ACK + GET /</text>
    <text x="262" y="296" style="fill: var(--viz-ok)">200 OK</text>
  </g>
  <!-- Server work between request and response -->
  <line x1="338" y1="228" x2="338" y2="250" stroke-width="5" style="stroke: var(--viz-warn)" />
  <text x="350" y="246" font-size="19" style="fill: var(--viz-warn)">work</text>

  <!-- Round-trip brackets -->
  <g stroke-width="2" fill="none" style="stroke: var(--viz-ink)">
    <path d="M70 96 h-8 v88 h8" />
    <path d="M70 188 h-8 v106 h8" />
  </g>
  <g font-size="19" font-weight="700" text-anchor="end" style="fill: var(--viz-ink)">
    <text x="56" y="138">1</text>
    <text x="56" y="160">RTT</text>
    <text x="56" y="238">1</text>
    <text x="56" y="260">RTT</text>
  </g>
</svg>
