---
// Behind the address: CDN edge, load balancer, a pool of app servers, then cache and database.
// A cache hit at the edge answers without going any deeper.
---

<svg viewBox="0 0 400 418" width="100%" role="img" aria-labelledby="hw-srv-t hw-srv-d">
  <title id="hw-srv-t">What sits behind the address</title>
  <desc id="hw-srv-d">
    A request from the browser first reaches a CDN edge server near the user, which may answer
    straight away from its cache. If not, it goes on to a load balancer, which picks one of
    several identical app servers. The app server runs your code and reads from a cache and a
    database, which hold the data. The answer travels back up the same path.
  </desc>
  <defs>
    <marker id="hw-srv-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="hw-srv-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
  </defs>

  <g font-size="19" text-anchor="middle" font-weight="700" style="fill: var(--viz-ink)">
    <rect x="6" y="6" width="200" height="50" rx="14" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" stroke-width="2" />
    <text x="106" y="38">Browser</text>

    <rect x="6" y="92" width="200" height="50" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="106" y="124">CDN edge</text>

    <rect x="6" y="178" width="200" height="50" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="106" y="210">Load balancer</text>

    <!-- A pool of identical app servers, drawn as a stack -->
    <rect x="18" y="258" width="188" height="50" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <rect x="12" y="264" width="188" height="50" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <rect x="6" y="270" width="188" height="50" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="100" y="302">App servers</text>

    <!-- Cache and database -->
    <path d="M6 362 a46 9 0 0 1 92 0 v38 a46 9 0 0 1 -92 0 z" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" stroke-width="2" />
    <path d="M6 362 a46 9 0 0 0 92 0" fill="none" style="stroke: var(--viz-store)" stroke-width="2" />
    <text x="52" y="394" font-weight="600">Cache</text>
    <path d="M110 362 a48 9 0 0 1 96 0 v38 a48 9 0 0 1 -96 0 z" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" stroke-width="2" />
    <path d="M110 362 a48 9 0 0 0 96 0" fill="none" style="stroke: var(--viz-store)" stroke-width="2" />
    <text x="158" y="394" font-weight="600">Database</text>
  </g>

  <!-- The request going deeper -->
  <g stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#hw-srv-flow)">
    <line x1="76" y1="58" x2="76" y2="89" />
    <line x1="76" y1="144" x2="76" y2="175" />
    <line x1="76" y1="230" x2="76" y2="255" />
    <line x1="52" y1="322" x2="52" y2="350" />
    <line x1="150" y1="322" x2="156" y2="350" />
  </g>
  <!-- A cache hit at the edge comes straight back -->
  <line x1="150" y1="90" x2="150" y2="60" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-ok)" marker-end="url(#hw-srv-ok)" />
  <text x="160" y="82" font-size="19" font-weight="600" style="fill: var(--viz-ok)">hit</text>

  <!-- What each layer is for -->
  <g font-size="19" style="fill: var(--viz-muted)">
    <text x="222" y="112">near the user,</text>
    <text x="222" y="136">keeps copies</text>
    <text x="222" y="198">picks a healthy</text>
    <text x="222" y="222">server</text>
    <text x="222" y="288">your code</text>
    <text x="222" y="312">runs here</text>
    <text x="222" y="380">the data</text>
    <text x="222" y="404">lives here</text>
  </g>
</svg>
