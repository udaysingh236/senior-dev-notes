---
// Requests borrow one of a few long-lived connections; each connection is one Postgres process.
---

<svg viewBox="0 0 400 300" width="100%" role="img" aria-labelledby="cp-ov-t cp-ov-d">
  <title id="cp-ov-t">A connection pool between requests and the database</title>
  <desc id="cp-ov-d">
    Six requests in one app process. Four of them each hold one of the pool's four open connections.
    The other two wait in the pool's queue for the next connection to be returned. Each connection is
    a long-lived session with one Postgres process behind it, about 1.3 MB of private memory when idle.
    Opening a new connection costs 2 to 10 ms; running a small query on an open one costs about 0.05 ms.
  </desc>
  <defs>
    <marker id="cp-ov-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-warn)" />
    </marker>
  </defs>

  <text x="4" y="20" font-size="17" font-weight="700" style="fill: var(--viz-ink)">requests</text>
  <text x="272" y="20" font-size="17" font-weight="700" style="fill: var(--viz-warn)">waiting</text>
  {[0, 1, 2, 3].map((i) => (
    <g>
      <rect x={4 + i * 64} y="30" width="56" height="30" rx="8" stroke-width="1.5" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
      <text x={32 + i * 64} y="51" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">req {i + 1}</text>
      <path d={`M${32 + i * 64} 60 L${32 + i * 64} 102`} stroke-width="2" style="stroke: var(--viz-flow)" />
      <rect x={4 + i * 64} y="102" width="56" height="30" rx="4" stroke-width="1.5" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
      <text x={32 + i * 64} y="123" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">conn</text>
      <path d={`M${32 + i * 64} 132 L${32 + i * 64} 204`} stroke-width="2" style="stroke: var(--viz-flow)" />
      <rect x={4 + i * 64} y="204" width="56" height="30" rx="4" stroke-width="1.5" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" />
      <text x={32 + i * 64} y="225" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">proc</text>
    </g>
  ))}

  <rect x="272" y="30" width="122" height="30" rx="4" stroke-width="1.5" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  <path d="M333 30 L333 60" stroke-width="1.5" style="stroke: var(--viz-warn)" />
  <text x="302" y="51" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">req 5</text>
  <text x="364" y="51" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">req 6</text>
  <path d="M300 60 C 300 100, 290 117, 266 117" fill="none" stroke-width="2" stroke-dasharray="5 4" marker-end="url(#cp-ov-a)" style="stroke: var(--viz-warn)" />

  <rect x="0" y="90" width="260" height="54" rx="10" fill="none" stroke-width="1.5" stroke-dasharray="6 4" style="stroke: var(--viz-muted)" />
  <text x="312" y="104" font-size="17" font-weight="700" style="fill: var(--viz-ink)">pool of 4</text>
  <text x="312" y="126" font-size="15" style="fill: var(--viz-muted)">kept open,</text>
  <text x="312" y="146" font-size="15" style="fill: var(--viz-muted)">lent one at</text>
  <text x="312" y="166" font-size="15" style="fill: var(--viz-muted)">a time</text>

  <text x="272" y="210" font-size="17" font-weight="700" style="fill: var(--viz-ink)">Postgres</text>
  <text x="272" y="231" font-size="15" style="fill: var(--viz-muted)">one process per</text>
  <text x="272" y="251" font-size="15" style="fill: var(--viz-muted)">connection</text>

  <text x="4" y="266" font-size="15" style="fill: var(--viz-muted)">open a connection: 2–10 ms, ≈1.3 MB idle</text>
  <text x="4" y="290" font-size="15" style="fill: var(--viz-ok)">query on an open one: ≈0.05 ms</text>
</svg>
