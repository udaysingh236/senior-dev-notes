---
// Top: the attempt holding the key dies after the bank call. Retries get 409 until the 5 s lease
// ends, then one takes over. Retry times follow the sim on the page: 0.5, 1, 2, 4 s after each failure.
// Bottom: a 1 s lease is shorter than a 2.4 s attempt. A retry takes over while the first attempt is
// alive; the first attempt's final UPDATE matches 0 rows because it no longer owns the row.
const X0 = 64;
const top = { y: 36, scale: 31, max: 10, ticks: [0, 2, 4, 6, 8, 10] }; // 10 s over 310 px
const bot = { y: 246, scale: 77.5, max: 4, ticks: [0, 1, 2, 3, 4] }; // 4 s over 310 px
const tx = (p: typeof top, s: number) => X0 + s * p.scale;
const retries = [1.7, 2.7, 4.7];
---

<svg viewBox="0 0 400 452" width="100%" role="img" aria-labelledby="ik-lease-t ik-lease-d">
  <title id="ik-lease-t">A lease ends a dead attempt's hold on a key, and a fence stops a live one from finishing twice</title>
  <desc id="ik-lease-d">
    Top timeline, 0 to 10 seconds, lease 5 seconds. Try 1 claims the key at 0, calls the bank and
    crashes at 1.2 seconds. Its row still says in progress. Retries at 1.7, 2.7 and 4.7 seconds get
    409 because the lease runs until 5 seconds. The retry at 8.7 seconds finds the lease over, takes
    the row over, calls the bank with the same downstream key, gets the first charge back, and
    finishes. Bottom timeline, 0 to 4 seconds, lease 1 second. Try 1 is slow and runs until 2.4
    seconds. Try 2 arrives at 1.5 seconds, finds the lease over and takes the row over while try 1
    is still running. At 2.4 seconds try 1's final update says WHERE owner = 1 and matches no rows,
    so it changes nothing. Try 2 finishes at 3 seconds.
  </desc>

  {/* --- top panel: crash and takeover --- */}
  <text x="4" y={top.y} font-size="17" font-weight="700" style="fill: var(--viz-ink)">a crash: retries wait out the lease</text>
  {top.ticks.map((s) => (
    <g>
      <line x1={tx(top, s)} y1={top.y + 12} x2={tx(top, s)} y2={top.y + 156} stroke-width="1" stroke-dasharray="2 4" style="stroke: var(--viz-stroke)" />
      <text x={tx(top, s)} y={top.y + 176} font-size="14" text-anchor="middle" style="font-family: var(--sl-font-mono); fill: var(--viz-muted)">{s} s</text>
    </g>
  ))}
  {/* lease */}
  <text x="4" y={top.y + 42} font-size="15" style="fill: var(--viz-ink)">lease</text>
  <rect x={tx(top, 0)} y={top.y + 28} width={5 * top.scale} height="18" rx="4" stroke-width="1.5" stroke-dasharray="5 3"
    style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  <text x={tx(top, 2.5)} y={top.y + 42} font-size="13" text-anchor="middle" style="fill: var(--viz-ink)">owner = try 1</text>
  {/* try 1 */}
  <text x="4" y={top.y + 84} font-size="15" style="fill: var(--viz-ink)">try 1</text>
  <rect x={tx(top, 0)} y={top.y + 70} width={1.2 * top.scale} height="18" rx="4" stroke-width="1.5" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
  <text x={tx(top, 0.6)} y={top.y + 64} font-size="13" text-anchor="middle" style="fill: var(--viz-ink)">charge</text>
  <text x={tx(top, 1.2) + 4} y={top.y + 85} font-size="16" font-weight="700" style="fill: var(--viz-bad)">✗ dies</text>
  {/* retries */}
  <text x="4" y={top.y + 128} font-size="15" style="fill: var(--viz-ink)">retries</text>
  {retries.map((s) => (
    <g>
      <circle cx={tx(top, s)} cy={top.y + 123} r="6" style="fill: var(--viz-warn)" />
      <text x={tx(top, s)} y={top.y + 146} font-size="13" text-anchor="middle" style="font-family: var(--sl-font-mono); fill: var(--viz-warn)">409</text>
    </g>
  ))}
  <rect x={tx(top, 8.7)} y={top.y + 114} width={1.0 * top.scale} height="18" rx="4" stroke-width="1.5" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" />
  <text x={tx(top, 8.7) - 4} y={top.y + 106} font-size="13" text-anchor="end" style="fill: var(--viz-ok)">take over, same bank key</text>
  <text x={tx(top, 9.7) + 4} y={top.y + 128} font-size="15" font-weight="700" style="fill: var(--viz-ok)">✓</text>

  {/* --- bottom panel: lease shorter than the work --- */}
  <text x="4" y={bot.y} font-size="17" font-weight="700" style="fill: var(--viz-ink)">a lease shorter than the work</text>
  {bot.ticks.map((s) => (
    <g>
      <line x1={tx(bot, s)} y1={bot.y + 12} x2={tx(bot, s)} y2={bot.y + 156} stroke-width="1" stroke-dasharray="2 4" style="stroke: var(--viz-stroke)" />
      <text x={tx(bot, s)} y={bot.y + 176} font-size="14" text-anchor="middle" style="font-family: var(--sl-font-mono); fill: var(--viz-muted)">{s} s</text>
    </g>
  ))}
  <text x="4" y={bot.y + 42} font-size="15" style="fill: var(--viz-ink)">lease</text>
  <rect x={tx(bot, 0)} y={bot.y + 28} width={1 * bot.scale} height="18" rx="4" stroke-width="1.5" stroke-dasharray="5 3"
    style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  <text x={tx(bot, 0.5)} y={bot.y + 42} font-size="13" text-anchor="middle" style="fill: var(--viz-ink)">try 1</text>
  <rect x={tx(bot, 1.5)} y={bot.y + 28} width={1 * bot.scale} height="18" rx="4" stroke-width="1.5" stroke-dasharray="5 3"
    style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  <text x={tx(bot, 2)} y={bot.y + 42} font-size="13" text-anchor="middle" style="fill: var(--viz-ink)">try 2</text>

  <text x="4" y={bot.y + 84} font-size="15" style="fill: var(--viz-ink)">try 1</text>
  <rect x={tx(bot, 0)} y={bot.y + 70} width={2.4 * bot.scale} height="18" rx="4" stroke-width="1.5" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
  <text x={tx(bot, 1.2)} y={bot.y + 84} font-size="13" text-anchor="middle" style="fill: var(--viz-ink)">slow, still alive</text>
  <circle cx={tx(bot, 2.4)} cy={bot.y + 79} r="5" style="fill: var(--viz-muted)" />
  <text x={tx(bot, 2.4) + 9} y={bot.y + 84} font-size="13" style="font-family: var(--sl-font-mono); fill: var(--viz-muted)">0 rows</text>

  <text x="4" y={bot.y + 128} font-size="15" style="fill: var(--viz-ink)">try 2</text>
  <rect x={tx(bot, 1.5)} y={bot.y + 114} width={1.5 * bot.scale} height="18" rx="4" stroke-width="1.5" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" />
  <text x={tx(bot, 2.25)} y={bot.y + 128} font-size="13" text-anchor="middle" style="fill: var(--viz-ink)">took over</text>
  <text x={tx(bot, 3) + 4} y={bot.y + 128} font-size="15" font-weight="700" style="fill: var(--viz-ok)">✓</text>
  <text x="396" y={bot.y + 104} font-size="13" text-anchor="end" style="font-family: var(--sl-font-mono); fill: var(--viz-muted)">UPDATE … WHERE owner = 'try 1'</text>

  <text x="4" y="446" font-size="15" style="font-family: var(--note-font-display); font-style: italic; fill: var(--viz-muted)">fence: no double write · bank key: no double charge</text>
</svg>
