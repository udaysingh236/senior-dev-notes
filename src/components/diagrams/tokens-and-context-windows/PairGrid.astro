---
// n tokens -> n × n pairs: 4 tokens make 16, 8 tokens make 64.
const grid = (x0: number, n: number, size: number) => {
  const cells: { x: number; y: number }[] = [];
  const c = size / n;
  for (let r = 0; r < n; r++) for (let k = 0; k < n; k++) cells.push({ x: x0 + k * c, y: 40 + r * c });
  return { cells, c };
};
const a = grid(14, 4, 150);
const b = grid(222, 8, 164);
---

<svg viewBox="0 0 400 270" width="100%" role="img" aria-labelledby="tcw-pg-t tcw-pg-d">
  <title id="tcw-pg-t">Doubling the tokens makes four times as many pairs</title>
  <desc id="tcw-pg-d">
    Two grids. On the left, 4 tokens by 4 tokens: 16 squares, one per pair the model compares. On the right,
    8 tokens by 8 tokens: 64 squares. Twice the tokens, four times the pairs.
  </desc>
  <text x="89" y="24" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">4 tokens</text>
  {a.cells.map((p) => (
    <rect x={p.x + 1} y={p.y + 1} width={a.c - 2} height={a.c - 2} rx="3" stroke-width="1.5" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
  ))}
  <text x="89" y="222" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">4 × 4 = 16 pairs</text>
  <text x="304" y="24" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">8 tokens</text>
  {b.cells.map((p) => (
    <rect x={p.x + 1} y={p.y + 1} width={b.c - 2} height={b.c - 2} rx="2" stroke-width="1.2" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  ))}
  <text x="304" y="232" font-size="16" text-anchor="middle" style="fill: var(--viz-ink)">8 × 8 = 64 pairs</text>
  <text x="200" y="262" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">twice the tokens, four times the work</text>
</svg>
