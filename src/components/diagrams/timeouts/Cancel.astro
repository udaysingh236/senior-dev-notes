---
// A client with a 0.5 s deadline calls a handler that needs 2 s of work.
// Numbers from examples/timeouts (python and js), section 2 / 3.
const X0 = 16;
const S = 170; // drawing units per second; 0 to 2.2 s
const x = (s: number) => X0 + s * S;
---

<svg viewBox="0 0 400 330" width="100%" role="img" aria-labelledby="to-cn-t to-cn-d">
  <title id="to-cn-t">A timeout stops the waiting, not the work</title>
  <desc id="to-cn-d">
    Two timelines from 0 to 2.2 seconds. In the first, the client gives up at 0.5 seconds, but the
    server's handler does not know and works through all 10 steps until 2.0 seconds, then finds
    nobody to send the answer to: 1.5 seconds of work for nobody. In the second, the client sends
    its remaining time in a header; the handler checks it before each step and stops at 0.4 seconds
    with a 504, so the client gets an answer before its deadline and the server stops working.
  </desc>

  <text x="4" y="22" font-size="17" font-weight="700" style="fill: var(--viz-ink)">client deadline 0.5 s, handler needs 2 s</text>

  <text x="4" y="62" font-size="16" style="fill: var(--viz-ink)">handler ignores the caller</text>
  <text x="4" y="88" font-size="15" style="fill: var(--viz-muted)">client</text>
  <rect x={x(0)} y="94" width={0.5 * S} height="14" rx="2" stroke-width="1.2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
  <text x={x(0.5) + 8} y="106" font-size="15" style="fill: var(--viz-bad)">gives up at 0.5 s</text>
  <text x="4" y="132" font-size="15" style="fill: var(--viz-muted)">server</text>
  <rect x={x(0)} y="138" width={0.5 * S} height="18" rx="2" stroke-width="1.2" style="fill: var(--viz-flow-soft); stroke: var(--viz-flow)" />
  <rect x={x(0.5)} y="138" width={1.5 * S} height="18" rx="2" stroke-width="1.2" stroke-dasharray="4 3" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" />
  <text x={x(1.25)} y="176" font-size="15" text-anchor="middle" style="fill: var(--viz-warn)">1.5 s of work for nobody</text>

  <text x="4" y="214" font-size="16" style="fill: var(--viz-ink)">handler checks the remaining time</text>
  <text x="4" y="240" font-size="15" style="fill: var(--viz-muted)">client</text>
  <rect x={x(0)} y="246" width={0.4 * S} height="14" rx="2" stroke-width="1.2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
  <text x={x(0.4) + 8} y="258" font-size="15" style="fill: var(--viz-ok)">gets a 504 at 0.4 s</text>
  <text x="4" y="284" font-size="15" style="fill: var(--viz-muted)">server</text>
  <rect x={x(0)} y="290" width={0.4 * S} height="18" rx="2" stroke-width="1.2" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" />
  <text x={x(0.4) + 8} y="304" font-size="15" style="fill: var(--viz-ok)">stops: not enough time for step 3</text>
</svg>
