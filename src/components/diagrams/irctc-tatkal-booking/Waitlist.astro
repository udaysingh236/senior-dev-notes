---
// A waitlist is a queue of people who already paid, behind the confirmed seats. A cancellation
// frees a seat and everyone behind it moves up one place, until the chart freezes the order.
---

<svg viewBox="0 0 400 300" width="100%" role="img" aria-labelledby="tk-wl-t tk-wl-d">
  <title id="tk-wl-t">How a cancellation moves the waitlist</title>
  <desc id="tk-wl-d">
    A row of confirmed seats, then RAC 1 and RAC 2, people who share a berth, then waitlist
    places WL 1 to WL 3. One confirmed seat is cancelled, marked with a red cross. Arrows show RAC
    1 taking the freed berth, RAC 2 moving up, and WL 1 becoming RAC. Below, a note says the chart,
    prepared hours before departure, freezes the order, and a ticket still on the waitlist then is
    cancelled and refunded.
  </desc>
  <defs>
    <marker id="tk-wl-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
  </defs>

  <g font-size="17" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">
    <text x="8" y="24" text-anchor="start">Confirmed</text>
    <text x="214" y="24" text-anchor="start">RAC</text>
    <text x="306" y="24" text-anchor="start">Waitlist</text>
  </g>

  <g font-size="16" font-weight="600" text-anchor="middle" style="fill: var(--viz-ink)">
    <!-- Confirmed -->
    <rect x="8" y="36" width="44" height="44" rx="4" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <rect x="58" y="36" width="44" height="44" rx="4" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <rect x="108" y="36" width="44" height="44" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-bad)" stroke-width="2" />
    <path d="M118 46 l24 24 M142 46 l-24 24" stroke-width="2.5" style="stroke: var(--viz-bad)" />
    <rect x="158" y="36" width="44" height="44" rx="4" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />

    <!-- RAC -->
    <rect x="214" y="36" width="40" height="44" rx="4" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" stroke-width="2" />
    <text x="234" y="64">R1</text>
    <rect x="258" y="36" width="40" height="44" rx="4" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" stroke-width="2" />
    <text x="278" y="64">R2</text>

    <!-- Waitlist -->
    <rect x="306" y="36" width="26" height="44" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" stroke-width="2" />
    <text x="319" y="64" font-size="16">1</text>
    <rect x="336" y="36" width="26" height="44" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" stroke-width="2" />
    <text x="349" y="64" font-size="16">2</text>
    <rect x="366" y="36" width="26" height="44" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-stroke)" stroke-width="2" />
    <text x="379" y="64" font-size="16">3</text>
  </g>

  <text x="130" y="104" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-bad)">cancelled</text>

  <!-- Everyone moves up one -->
  <g fill="none" stroke-width="2" style="stroke: var(--viz-ok)" marker-end="url(#tk-wl-ok)">
    <path d="M234 82 C 234 140, 140 140, 132 108" />
    <path d="M278 82 C 278 120, 244 120, 238 86" />
    <path d="M319 82 C 319 120, 288 120, 282 86" />
  </g>
  <g font-size="16" style="fill: var(--viz-ok)">
    <text x="8" y="168">R1 gets the berth, R2 becomes R1,</text>
    <text x="8" y="190">WL 1 becomes RAC: everyone moves up.</text>
  </g>

  <line x1="8" y1="214" x2="392" y2="214" stroke-width="1.5" stroke-dasharray="4 4" style="stroke: var(--viz-stroke)" />
  <g font-size="16" style="fill: var(--viz-ink)">
    <text x="8" y="242" font-weight="700">Chart prepared (hours before departure)</text>
    <text x="8" y="266">The order freezes. A ticket still on the</text>
    <text x="8" y="288">waitlist is cancelled and refunded.</text>
  </g>
</svg>
