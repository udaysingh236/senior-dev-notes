---
// How a waiting room turns a spike into a steady stream: everyone gets a numbered, signed place
// in line at the edge, the room lets people through at a fixed rate, and when the quota is gone
// it tells everyone still waiting without touching the booking servers.
---

<svg viewBox="0 0 400 380" width="100%" role="img" aria-labelledby="tk-wr-t tk-wr-d">
  <title id="tk-wr-t">A waiting room in front of the booking servers</title>
  <desc id="tk-wr-d">
    On the left, a tall spike of arrivals at 10:00:00. In the middle, a queue of numbered places,
    numbered from the back, with number 1 at the front next to the exit, each with a signed token. On the right, the booking servers receive a
    steady stream of 200 users per second, well under their limit. A red arrow from the room back
    to the people still waiting says sold out, sent from the edge without reaching the servers.
  </desc>
  <defs>
    <marker id="tk-wr-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="tk-wr-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
    <marker id="tk-wr-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-bad)" />
    </marker>
  </defs>

  <!-- Arrivals spike -->
  <g>
    <text x="8" y="22" font-size="17" font-weight="600" style="fill: var(--viz-ink)">Arrivals</text>
    <line x1="8" y1="150" x2="120" y2="150" stroke-width="1.5" style="stroke: var(--viz-stroke)" />
    <path d="M8 148 L30 146 L36 40 L44 60 L52 110 L64 132 L84 142 L120 146" fill="none" stroke-width="2.5" style="stroke: var(--viz-flow)" />
    <text x="36" y="172" font-size="16" text-anchor="middle" style="fill: var(--viz-muted)">10:00:00</text>
  </g>

  <!-- Queue of numbered places -->
  <g font-size="17" font-weight="600" text-anchor="middle" style="fill: var(--viz-ink)">
    <text x="200" y="210">Waiting room (at the edge)</text>
    <rect x="8" y="222" width="384" height="56" rx="6" style="fill: var(--viz-warn-soft); stroke: var(--viz-warn)" stroke-width="2" />
    <rect x="18" y="232" width="50" height="36" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-warn)" stroke-width="1.5" />
    <text x="43" y="257">#6</text>
    <rect x="78" y="232" width="50" height="36" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-warn)" stroke-width="1.5" />
    <text x="103" y="257">#5</text>
    <rect x="138" y="232" width="50" height="36" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-warn)" stroke-width="1.5" />
    <text x="163" y="257">#4</text>
    <rect x="198" y="232" width="50" height="36" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-warn)" stroke-width="1.5" />
    <text x="223" y="257">#3</text>
    <rect x="258" y="232" width="50" height="36" rx="4" style="fill: var(--viz-surface); stroke: var(--viz-warn)" stroke-width="1.5" />
    <text x="283" y="257">#2</text>
    <rect x="318" y="232" width="64" height="36" rx="4" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <text x="350" y="257">#1</text>
  </g>

  <!-- Spike into the room -->
  <path d="M70 176 C 70 200, 40 205, 40 218" fill="none" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#tk-wr-flow)" />

  <!-- Booking servers -->
  <g font-size="19" font-weight="600" text-anchor="middle" style="fill: var(--viz-ink)">
    <rect x="216" y="40" width="176" height="80" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="304" y="72">Booking servers</text>
    <text x="304" y="98" font-size="16" font-weight="400">busy, not drowning</text>
  </g>

  <!-- Steady admission -->
  <path d="M350 230 L350 124" fill="none" stroke-width="2.5" style="stroke: var(--viz-ok)" marker-end="url(#tk-wr-ok)" />
  <text x="340" y="160" font-size="16" text-anchor="end" style="fill: var(--viz-ok)">200 users/s,</text>
  <text x="340" y="180" font-size="16" text-anchor="end" style="fill: var(--viz-ok)">oldest first</text>

  <!-- Sold out, from the edge -->
  <path d="M200 290 L200 318" fill="none" stroke-width="2" stroke-dasharray="6 4" style="stroke: var(--viz-bad)" marker-end="url(#tk-wr-bad)" />
  <text x="200" y="342" font-size="17" font-weight="700" text-anchor="middle" style="fill: var(--viz-bad)">"Quota full" for everyone left,</text>
  <text x="200" y="366" font-size="16" text-anchor="middle" style="fill: var(--viz-muted)">sent by the edge, no server work</text>
</svg>
