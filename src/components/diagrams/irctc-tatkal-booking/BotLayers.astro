---
// Defence in depth against booking bots: each layer is a filter that a script has to get past,
// and each uses different evidence. The two bottom layers are published IRCTC rules.
---

<svg viewBox="0 0 400 360" width="100%" role="img" aria-labelledby="tk-bot-t tk-bot-d">
  <title id="tk-bot-t">Layers between a bot and a Tatkal seat</title>
  <desc id="tk-bot-d">
    Four stacked filters, each narrower than the one above. The edge looks at the traffic itself.
    Login checks the account with a CAPTCHA and an Aadhaar OTP. The account layer limits what one
    identity can do. The rules layer bars agents for the first 30 minutes and caps a booking at
    four passengers. Red arrows leave each layer to the side: the traffic it stopped.
  </desc>
  <defs>
    <marker id="tk-bot-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-bad)" />
    </marker>
  </defs>

  <g font-size="19" font-weight="600" style="fill: var(--viz-ink)">
    <rect x="8" y="12" width="320" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="20" y="38">1 Edge</text>
    <text x="20" y="64" font-size="16" font-weight="400">request rate, IP, browser signals</text>

    <rect x="28" y="96" width="280" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="40" y="122">2 Login</text>
    <text x="40" y="148" font-size="16" font-weight="400">CAPTCHA, Aadhaar OTP</text>

    <rect x="48" y="180" width="240" height="64" rx="6" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" stroke-width="2" />
    <text x="60" y="206">3 Account</text>
    <text x="60" y="232" font-size="16" font-weight="400">verified, not suspicious</text>

    <rect x="68" y="264" width="200" height="88" rx="6" style="fill: var(--viz-ok-soft); stroke: var(--viz-ok)" stroke-width="2" />
    <text x="80" y="290">4 Rules</text>
    <text x="80" y="316" font-size="16" font-weight="400">no agents till 10:30,</text>
    <text x="80" y="340" font-size="16" font-weight="400">4 per PNR</text>
  </g>

  <!-- What each layer stops -->
  <g stroke-width="2" style="stroke: var(--viz-bad)" marker-end="url(#tk-bot-bad)">
    <line x1="329" y1="44" x2="380" y2="44" />
    <line x1="309" y1="128" x2="380" y2="128" />
    <line x1="289" y1="212" x2="380" y2="212" />
    <line x1="269" y1="296" x2="380" y2="296" />
  </g>
  <text x="392" y="96" font-size="16" font-weight="700" text-anchor="end" style="fill: var(--viz-bad)">stopped</text>

</svg>
