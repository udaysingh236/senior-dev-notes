---
// Hero diagram: the parts of the booking system in our design. Reads (availability) and writes
// (booking) take different paths; every write for one train and date goes to one inventory shard.
const box = (x: number, y: number, w: number, h: number) => ({ x, y, width: w, height: h });
---

<svg viewBox="0 0 400 452" width="100%" role="img" aria-labelledby="tk-arch-t tk-arch-d">
  <title id="tk-arch-t">The parts of a train booking system</title>
  <desc id="tk-arch-d">
    Web and app users pass an edge layer with bot checks and a waiting room, then reach stateless
    booking servers. Availability reads go to a read model: per-train snapshots that may be a few
    seconds old. Booking writes go to the inventory shard that owns that train and date, which holds
    the berth bitmasks, the quotas and the waitlist; station counters write to the same shard. The
    booking servers also talk to the payment gateway. A charting job reads the shard hours before
    departure and freezes it into the chart.
  </desc>
  <defs>
    <marker id="tk-arch-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
  </defs>

  <g font-size="17" font-weight="600" text-anchor="middle">
    <rect {...box(4, 4, 180, 40)} rx="14" stroke-width="2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
    <text x="94" y="30" style="fill: var(--viz-ink)">web and app users</text>
    <rect {...box(216, 4, 180, 40)} rx="14" stroke-width="2" style="fill: var(--viz-client-soft); stroke: var(--viz-client)" />
    <text x="306" y="30" style="fill: var(--viz-ink)">counters</text>

    <rect {...box(4, 74, 180, 52)} rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
    <text x="94" y="96" style="fill: var(--viz-ink)">edge: bot checks,</text>
    <text x="94" y="117" style="fill: var(--viz-ink)">waiting room</text>

    <rect {...box(4, 156, 180, 52)} rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
    <text x="94" y="178" style="fill: var(--viz-ink)">booking servers</text>
    <text x="94" y="199" font-size="15" font-weight="400" style="fill: var(--viz-muted)">stateless, many</text>

    <rect {...box(216, 156, 180, 52)} rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
    <text x="306" y="178" style="fill: var(--viz-ink)">payment gateway</text>
    <text x="306" y="199" font-size="15" font-weight="400" style="fill: var(--viz-muted)">UPI, cards, banks</text>

    <path d="M4 252 a90 10 0 0 1 180 0 v40 a90 10 0 0 1 -180 0 z" stroke-width="2" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" />
    <path d="M4 252 a90 10 0 0 0 180 0" fill="none" stroke-width="2" style="stroke: var(--viz-store)" />
    <text x="94" y="283" style="fill: var(--viz-ink)">read model</text>
    <text x="94" y="304" font-size="15" font-weight="400" style="fill: var(--viz-muted)">seconds old</text>

    <path d="M216 252 a90 10 0 0 1 180 0 v66 a90 10 0 0 1 -180 0 z" stroke-width="2.5" style="fill: var(--viz-store-soft); stroke: var(--viz-store)" />
    <path d="M216 252 a90 10 0 0 0 180 0" fill="none" stroke-width="2.5" style="stroke: var(--viz-store)" />
    <text x="306" y="282" style="fill: var(--viz-ink)">inventory shard</text>
    <text x="306" y="302" font-size="15" font-weight="400" style="fill: var(--viz-muted)">train + date: masks,</text>
    <text x="306" y="320" font-size="15" font-weight="400" style="fill: var(--viz-muted)">quotas, waitlist</text>

    <rect {...box(216, 372, 180, 44)} rx="6" stroke-width="2" stroke-dasharray="5 4" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
    <text x="306" y="400" style="fill: var(--viz-ink)">charting job</text>
  </g>

  <g stroke-width="2" fill="none" style="stroke: var(--viz-flow)" marker-end="url(#tk-arch-a)">
    <line x1="94" y1="45" x2="94" y2="70" />
    <line x1="94" y1="127" x2="94" y2="152" />
    <line x1="185" y1="182" x2="212" y2="182" />
    <line x1="94" y1="209" x2="94" y2="240" />
    <path d="M150 209 L280 242" />
    <path d="M370 45 V240" />
    <line x1="306" y1="332" x2="306" y2="368" />
  </g>
  <path d="M216 300 H186" stroke-width="2" stroke-dasharray="4 4" fill="none" style="stroke: var(--viz-store)" />
  <g font-size="15" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">
    <text x="102" y="230">reads</text>
    <text x="236" y="230" style="fill: var(--viz-flow)">writes</text>
    <text x="4" y="440">dashed: refreshed from the shard every few seconds</text>
  </g>
</svg>
