---
// Error budget left over one month of the checkout service (SLO 99.9%), from
// examples/slis-slos-error-budgets: background errors spend it slowly, the 20-minute outage on
// day 10 spends 46% at once, and the 3-day slow leak from day 18 spends 30%. 5% is left at the end.
// Points generated from slo_demo.py, one every 6 hours plus the start and end of each problem.
---

<svg viewBox="0 0 400 300" width="100%" role="img" aria-labelledby="slo-bm-t slo-bm-d">
  <title id="slo-bm-t">Error budget left over one month</title>
  <desc id="slo-bm-d">
    A line chart over 30 days. The error budget starts at 100% left and falls slowly because of
    background errors. On day 10 a 20-minute outage drops it by 46% almost at once. From day 18 to
    day 21 a slow leak of 0.3% errors makes it fall steeply for three days, spending 30%. The month
    ends with 5% of the budget left. The 5-minute blip on day 3 is too small to see.
  </desc>
  <g stroke-width="1" style="stroke: var(--viz-stroke)">
    <line x1="50" y1="30" x2="390" y2="30" />
    <line x1="50" y1="75" x2="390" y2="75" />
    <line x1="50" y1="120" x2="390" y2="120" />
    <line x1="50" y1="165" x2="390" y2="165" />
    <line x1="50" y1="210" x2="390" y2="210" stroke-width="1.5" style="stroke: var(--viz-muted)" />
  </g>
  <g font-size="15" text-anchor="end" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">
    <text x="44" y="35">100%</text>
    <text x="44" y="125">50%</text>
    <text x="44" y="215">0%</text>
  </g>
  <g font-size="15" text-anchor="middle" style="fill: var(--viz-muted); font-family: var(--sl-font-mono)">
    <text x="50" y="232">day 0</text>
    <text x="163.3" y="232">10</text>
    <text x="276.7" y="232">20</text>
    <text x="376" y="232">30</text>
  </g>
  <polyline points="50.0,30.0 52.8,30.3 55.7,30.6 58.5,30.9 61.3,31.2 64.2,31.5 67.0,31.8 69.8,32.1 72.7,32.4 75.5,32.7 78.3,33.0 81.2,33.3 84.0,33.6 86.8,33.9 88.7,34.1 88.8,35.1 89.7,35.2 92.5,35.5 95.3,35.8 98.2,36.1 101.0,36.4 103.8,36.7 106.7,37.0 109.5,37.3 112.3,37.6 115.2,37.9 118.0,38.2 120.8,38.5 123.7,38.8 126.5,39.1 129.3,39.4 132.2,39.7 135.0,40.0 137.8,40.3 140.7,40.6 143.5,40.9 146.3,41.2 149.2,41.5 152.0,41.8 154.8,42.1 157.7,42.4 160.5,42.7 163.3,43.0 166.2,43.3 169.0,43.6 169.9,43.7 170.1,127.1 171.8,127.3 174.7,127.6 177.5,127.9 180.3,128.2 183.2,128.5 186.0,128.8 188.8,129.1 191.7,129.4 194.5,129.7 197.3,130.0 200.2,130.3 203.0,130.6 205.8,130.9 208.7,131.2 211.5,131.5 214.3,131.8 217.2,132.1 220.0,132.4 222.8,132.7 225.7,133.0 228.5,133.3 231.3,133.6 234.2,133.9 237.0,134.2 239.8,134.5 242.7,134.8 245.5,135.1 248.3,135.4 251.2,135.7 254.0,136.0 256.8,140.5 259.7,145.0 262.5,149.5 265.3,154.0 268.2,158.5 271.0,163.0 273.8,167.5 276.7,172.0 279.5,176.5 282.3,181.0 285.2,185.5 288.0,190.0 290.8,190.3 293.7,190.6 296.5,190.9 299.3,191.2 302.2,191.5 305.0,191.8 307.8,192.1 310.7,192.4 313.5,192.7 316.3,193.0 319.2,193.3 322.0,193.6 324.8,193.9 327.7,194.2 330.5,194.5 333.3,194.8 336.2,195.1 339.0,195.4 341.8,195.7 344.7,196.0 347.5,196.3 350.3,196.6 353.2,196.9 356.0,197.2 358.8,197.5 361.7,197.8 364.5,198.1 367.3,198.4 370.2,198.7 373.0,199.0 375.8,199.3 378.7,199.6 381.5,199.9 384.3,200.2 387.2,200.5 390.0,200.8" fill="none" stroke-width="2.5" style="stroke: var(--viz-flow)" />
