---
// Six clients, six backends, two backends per client: random against deterministic subsets.
const random = [[1, 5], [1, 3], [5, 6], [1, 5], [2, 3], [5, 6]];
const deterministic = [[2, 5], [1, 4], [3, 6], [1, 6], [3, 4], [2, 5]];
const panels = [
  { title: 'random', x: 4, subsets: random },
  { title: 'deterministic', x: 210, subsets: deterministic },
];
const cell = 26;
const top = 58;
---

<svg viewBox="0 0 400 290" width="100%" role="img" aria-labelledby="lb-sub-t lb-sub-d">
  <title id="lb-sub-t">Random against deterministic subsets</title>
  <desc id="lb-sub-d">
    Two grids of six clients (rows) by six backends (columns); a filled cell means that client
    connects to that backend, two per client. Random subsets give the backends 3, 1, 2, 0, 4 and 2
    clients: backend 4 gets none and backend 5 gets four. Deterministic subsets, dealt in two rounds
    of three clients, give every backend exactly 2. Clients 1 to 3 form round one and clients 4 to 6
    round two; within each round every backend appears once.
  </desc>
  <text x="4" y="20" font-size="17" font-weight="700" style="fill: var(--viz-ink)">6 clients × 6 backends, 2 each</text>
  {
    panels.map((p) => {
      const left = p.x + 26;
      const totals = [1, 2, 3, 4, 5, 6].map((b) => p.subsets.filter((s) => s.includes(b)).length);
      return (
        <g>
          <text x={p.x} y="46" font-size="16" font-weight="700" style="fill: var(--viz-ink)">{p.title}</text>
          {p.subsets.map((s, c) => (
            <g>
              <text x={p.x} y={top + c * cell + 18} font-size="14" style="fill: var(--viz-muted)">c{c + 1}</text>
              {[1, 2, 3, 4, 5, 6].map((b, k) => (
                <rect x={left + k * cell + 2} y={top + c * cell + 2} width={cell - 4} height={cell - 4} rx="3" stroke-width="1.5"
                  style={s.includes(b) ? 'fill: var(--viz-flow-soft); stroke: var(--viz-flow)' : 'fill: none; stroke: var(--viz-stroke)'} />
              ))}
            </g>
          ))}
          {p.title === 'deterministic' && <line x1={left} y1={top + 3 * cell} x2={left + 6 * cell} y2={top + 3 * cell} stroke-width="2" stroke-dasharray="4 3" style="stroke: var(--viz-muted)" />}
          {totals.map((n, k) => (
            <text x={left + k * cell + cell / 2} y={top + 6 * cell + 22} font-size="16" font-weight="700" text-anchor="middle"
              style={n === 2 ? 'fill: var(--viz-ok)' : n > 2 ? 'fill: var(--viz-bad)' : 'fill: var(--viz-warn)'}>{n}</text>
          ))}
        </g>
      );
    })
  }
  <text x="4" y={top + 6 * cell + 50} font-size="14" style="fill: var(--viz-muted)">bottom row: clients per backend (even answer: 2)</text>
  <text x="4" y={top + 6 * cell + 70} font-size="14" style="fill: var(--viz-muted)">dashed line: the two rounds of deterministic subsetting</text>
</svg>
