---
// Part 1 mental model. Checkout saves the order, puts a note in the queue and replies in 60 ms.
// Email workers take notes from the front, send the email through the provider, and ack so the
// queue deletes the note. A note that fails 5 times goes to the dead-letter queue.
// Numbers from the page's running example.
---

<svg viewBox="0 0 400 470" width="100%" role="img" aria-labelledby="mq-mm-t mq-mm-d">
  <title id="mq-mm-t">A message queue between Checkout and the email workers</title>
  <desc id="mq-mm-d">
    Checkout saves order 1042, puts the note "email order 1042" into the queue and replies to the
    customer in 60 ms. The queue holds notes in order. Fifty email workers take notes from the
    front, send each email through the email provider in about 0.5 s, and then say done, so the
    queue deletes the note. A note that fails 5 times is moved to a dead-letter queue for a person
    to look at.
  </desc>
  <defs>
    <marker id="mq-mm-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-flow)" />
    </marker>
    <marker id="mq-mm-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-ok)" />
    </marker>
    <marker id="mq-mm-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" style="fill: var(--viz-bad)" />
    </marker>
  </defs>

  <!-- Checkout -->
  <rect x="4" y="8" width="150" height="62" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="79" y="35" font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">Checkout</text>
  <text x="79" y="58" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">saves order 1042</text>
  <text x="4" y="96" font-size="16" font-weight="700" style="fill: var(--viz-ok)">replies in 60 ms</text>

  <!-- arrow to queue -->
  <path d="M156 39 L 300 39 L 300 128" fill="none" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#mq-mm-a)" />
  <text x="228" y="30" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">"email order 1042"</text>

  <!-- queue -->
  <text x="396" y="122" font-size="16" font-weight="700" text-anchor="end" style="fill: var(--viz-ink)">queue</text>
  <rect x="104" y="134" width="292" height="44" rx="6" stroke-width="2" style="fill: var(--viz-surface); stroke: var(--viz-server)" />
  <g stroke-width="1.5" style="stroke: var(--viz-server)">
    <line x1="162" y1="134" x2="162" y2="178" />
    <line x1="220" y1="134" x2="220" y2="178" />
    <line x1="278" y1="134" x2="278" y2="178" />
    <line x1="336" y1="134" x2="336" y2="178" />
  </g>
  <rect x="108" y="138" width="50" height="36" rx="3" style="fill: var(--viz-flow-soft)" />
  <rect x="166" y="138" width="50" height="36" rx="3" style="fill: var(--viz-flow-soft)" />
  <rect x="224" y="138" width="50" height="36" rx="3" style="fill: var(--viz-flow-soft)" />
  <rect x="282" y="138" width="50" height="36" rx="3" style="fill: var(--viz-flow-soft)" />
  <text x="133" y="162" font-size="15" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">1039</text>
  <text x="191" y="162" font-size="15" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">1040</text>
  <text x="249" y="162" font-size="15" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">1041</text>
  <text x="307" y="162" font-size="15" text-anchor="middle" style="fill: var(--viz-ink); font-family: var(--sl-font-mono)">1042</text>
  <text x="104" y="198" font-size="15" style="fill: var(--viz-muted)">front</text>
  <text x="396" y="198" font-size="15" text-anchor="end" style="fill: var(--viz-muted)">back</text>

  <!-- dead-letter queue -->
  <path d="M120 180 L 120 228 L 92 254" fill="none" stroke-width="2" stroke-dasharray="5 4" style="stroke: var(--viz-bad)" marker-end="url(#mq-mm-bad)" />
  <text x="4" y="226" font-size="15" style="fill: var(--viz-bad)">fails 5 times</text>
  <rect x="4" y="258" width="150" height="62" rx="6" stroke-width="2" style="fill: var(--viz-bad-soft); stroke: var(--viz-bad)" />
  <text x="79" y="284" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">dead-letter</text>
  <text x="79" y="306" font-size="16" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">queue</text>

  <!-- workers -->
  <path d="M200 180 L 200 250" fill="none" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#mq-mm-a)" />
  <text x="208" y="222" font-size="15" style="fill: var(--viz-muted)">take from front</text>
  <path d="M382 250 L 382 182" fill="none" stroke-width="2" stroke-dasharray="5 4" style="stroke: var(--viz-ok)" marker-end="url(#mq-mm-ok)" />
  <text x="374" y="222" font-size="15" text-anchor="end" style="fill: var(--viz-ok)">done</text>
  <rect x="180" y="254" width="216" height="66" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="288" y="282" font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">Email workers</text>
  <text x="288" y="306" font-size="15" text-anchor="middle" style="fill: var(--viz-muted)">50 workers, 100 emails/s</text>

  <!-- provider -->
  <path d="M288 322 L 288 372" fill="none" stroke-width="2" style="stroke: var(--viz-flow)" marker-end="url(#mq-mm-a)" />
  <text x="296" y="352" font-size="15" style="fill: var(--viz-muted)">0.5 s each</text>
  <rect x="180" y="376" width="216" height="56" rx="6" stroke-width="2" style="fill: var(--viz-server-soft); stroke: var(--viz-server)" />
  <text x="288" y="410" font-size="18" font-weight="700" text-anchor="middle" style="fill: var(--viz-ink)">Email provider</text>

  <text x="4" y="460" font-size="15" font-style="italic" style="fill: var(--viz-muted); font-family: var(--note-font-display)">a taken note is hidden for 30 s, not deleted</text>
</svg>
